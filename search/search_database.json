g , schema , ierr = ierr ) else block type ( nml_schema_t ) :: sch call read_config_from_string_impl ( text , cfg , sch , ierr = ierr ) end block end if end subroutine read_config_from_string","tags":"","url":"proc/read_config_from_string.html"},{"title":"validate_config – Roundabout","text":"public  subroutine validate_config(cfg, ierr) Uses rdb_ocean_tidal_mixing rdb_ocean_pseudo_salt rdb_ocean_lateral_mix rdb_ocean_boundary_types rdb_constants rdb_recon_weno rdb_ocean_vmix rdb_ocean_horizontal_viscosity rdb_ocean_surface_flux rdb_vcoord rdb_ocean_bottom_drag rdb_ocean_pressure_force rdb_coriolis_adv proc~~validate_config~~UsesGraph proc~validate_config validate_config module~rdb_constants rdb_constants proc~validate_config->module~rdb_constants module~rdb_coriolis_adv rdb_coriolis_adv proc~validate_config->module~rdb_coriolis_adv module~rdb_ocean_bottom_drag rdb_ocean_bottom_drag proc~validate_config->module~rdb_ocean_bottom_drag module~rdb_ocean_boundary_types rdb_ocean_boundary_types proc~validate_config->module~rdb_ocean_boundary_types module~rdb_ocean_horizontal_viscosity rdb_ocean_horizontal_viscosity proc~validate_config->module~rdb_ocean_horizontal_viscosity module~rdb_ocean_lateral_mix rdb_ocean_lateral_mix proc~validate_config->module~rdb_ocean_lateral_mix module~rdb_ocean_pressure_force rdb_ocean_pressure_force proc~validate_config->module~rdb_ocean_pressure_force module~rdb_ocean_pseudo_salt rdb_ocean_pseudo_salt proc~validate_config->module~rdb_ocean_pseudo_salt module~rdb_ocean_surface_flux rdb_ocean_surface_flux proc~validate_config->module~rdb_ocean_surface_flux module~rdb_ocean_tidal_mixing rdb_ocean_tidal_mixing proc~validate_config->module~rdb_ocean_tidal_mixing module~rdb_ocean_vmix rdb_ocean_vmix proc~validate_config->module~rdb_ocean_vmix module~rdb_recon_weno rdb_recon_weno proc~validate_config->module~rdb_recon_weno module~rdb_vcoord rdb_vcoord proc~validate_config->module~rdb_vcoord pic_types pic_types module~rdb_constants->pic_types modul