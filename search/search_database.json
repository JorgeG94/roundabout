 rdb_ocean_step proc~rdb_ocean_step->proc~engine_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine sponge_relax_band_y_tracer ( ms , it , nx_total , ny_total , nz , & i0 , i1 , wall_face , band , side , strength , C_bc , dt ) !! Mirror of `sponge_relax_band_x_tracer` for the y-direction. type ( multilayer_state_t ), intent ( inout ) :: ms integer , intent ( in ) :: it , nx_total , ny_total , nz , i0 , i1 , wall_face , band , side real ( wp ), intent ( in ) :: strength , C_bc , dt if ( it == ms % idx_salinity ) then call relax_band_y_impl ( ms % tracers ( it )% hTr , ms % h_layer , nx_total , ny_total , nz , & i0 , i1 , wall_face , band , side , strength , C_bc , dt , & budget = ms % salt_budget_sponge ) else if ( it == ms % idx_temperature ) then call relax_band_y_impl ( ms % tracers ( it )% hTr , ms % h_layer , nx_total , ny_total , nz , & i0 , i1 , wall_face , band , side , strength , C_bc , dt , & budget = ms % heat_budget_sponge ) else call relax_band_y_impl ( ms % tracers ( it )% hTr , ms % h_layer , nx_total , ny_total , nz , & i0 , i1 , wall_face , band , side , strength , C_bc , dt ) end if end subroutine sponge_relax_band_y_tracer","tags":"","url":"proc/sponge_relax_band_y_tracer.html"},{"title":"bipolar_pole_lat – Roundabout","text":"public pure function bipolar_pole_lat(phi_join) result(lat) Latitude (deg) of the two cap poles — they sit ON the join\nlatitude, so this is simply phi_join . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: phi_join Return Value real(kind=wp) Source Code pure function bipolar_pole_lat ( phi_join ) result ( lat ) !! Latitude (deg) of the two cap poles — they sit ON the join !! latitude, so this is simply `phi_join`. real ( wp ), intent ( in ) :: phi_join real ( wp ) :: lat lat = phi_join end function bipolar_pole_lat","tags":"","url":"proc/bipolar_pole_lat.html"},{"title":"bipolar_corner_latlon – Roundabout","text":"public pure subroutine bipolar_corner_latlon(lam_deg, s, phi_join, lon_pole, lat, lon) Map a logical cap location to geographic (lat, lon) in degrees. lam_deg : pseudo-longitude (geographic lon at the join ring),\n              any real (wrapped internally); the i-direction. s : cap-row fraction, 0 = join ring ( lat = phi_join ),\n              1 = fold line; the j-direction. phi_join : join latitude (deg); cap covers lat > phi_join. lon_pole : longitude (deg) of the first cap pole; partner at lon_pole + 180 . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: lam_deg real(kind=wp), intent(in) :: s real(kind=wp), intent(in) :: phi_join real(kind=wp), intent(in) :: lon_pole real(kind=wp), intent(out) :: lat real(kind=wp), intent(out) :: lon Called by proc~~bipolar_corner_latlon~~CalledByGraph proc~bipolar_corner_latlon bipolar_corner_latlon proc~tripolar_node_latlon tripolar_node_latlon proc~tripolar_node_latlon->proc~bipolar_corner_latlon proc~metrics_fill_tripolar metrics_fill_tripolar proc~metrics_fill_tripolar->proc~tripolar_node_latlon proc~configure_ocean_metrics configure_ocean_metrics proc~configure_ocean_metrics->proc~metrics_fill_tripolar proc~engine_setup engine_setup proc~engine_setup->proc~configure_ocean_metrics proc~complete_ocean_create complete_ocean_create proc~complete_ocean_create->proc~engine_setup proc~driver_run_ocean driver_run_ocean proc~driver_run_ocean->proc~engine_setup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: a_focus real(kind=wp), private :: deni real(kind=wp), private :: denr real(kind=wp), private :: dnorm real(kind=wp), private :: half real(kind=wp), private :: lpr real(kind=wp), private :: mu real(kind=wp), private :: rmag real(kind=wp), private :: sgn real(kind=wp), private :: t real(kind=wp), private :: wi real(kind=wp), private :: wr real(kind=wp), private :: xi real(kind=wp), private :: zi real(kind=wp), private :: zpi real(kind=wp), private :: zpr real(kind=wp), private :: zr Source Code pure subroutine bipolar_corner_latlon ( lam_deg , s , phi_join , lon_pole , lat , lon ) !! Map a logical cap location to geographic (lat, lon) in degrees. !!   `lam_deg` : pseudo-longitude (geographic lon at the join ring), !!               any real (wrapped internally); the i-direction. !!   `s`       : cap-row fraction, 0 = join ring (`lat = phi_join`), !!               1 = fold line; the j-direction. !!   `phi_join`: join latitude (deg); cap covers lat > phi_join. !!   `lon_pole`: longitude (deg) of the first cap pole; partner at !!               `lon_pole + 180`. real ( wp ), intent ( in ) :: lam_deg , s , phi_join , lon_pole real ( wp ), intent ( out ) :: lat , lon real ( wp ) :: a_focus , half , t , mu , xi , sgn real ( wp ) :: wr , wi , denr , deni , dnorm , zpr , zpi real ( wp ) :: lpr , zr , zi , rmag a_focus = tan ( DEG2RAD * ( 9 0.0_wp - phi_join ) * 0.5_wp ) ! mu from the join-continuity relation: lon_join = lon_pole + 2 atan(exp(mu)). half = DEG2RAD * ( lam_deg - lon_pole ) * 0.5_wp t = tan ( half ) if ( t > 0.0_wp ) then sgn = 1.0_wp mu = log ( t ) else if ( t < 0.0_wp ) then sgn = - 1.0_wp mu = log ( - t ) else ! lam == lon_pole (mod 360): a cap pole.  mu -> -inf; clamp finite ! so the corner sits arbitrarily close to the pole without an Inf. sgn = 1.0_wp mu = - 5 0.0_wp end if ! xi rotates from the join (sgn*pi/2) to the fold (sgn*pi) as s: 0 -> 1. xi = sgn * ( PI * 0.5_wp + s * PI * 0.5_wp ) ! w = exp(mu) * exp(i*xi) wr = exp ( mu ) * cos ( xi ) wi = exp ( mu ) * sin ( xi ) ! Zp = A * (1 + w)/(1 - w) denr = 1.0_wp - wr deni = - wi dnorm = denr * denr + deni * deni if ( dnorm <= 0.0_wp ) then ! w == 1 (mu -> +inf): the other pole.  Place at phi_join on the ! partner meridian. lat = phi_join lon = lon_pole + 18 0.0_wp if ( lon >= 18 0.0_wp ) lon = lon - 36 0.0_wp return end if ! (1+w)/(1-w) zpr = (( 1.0_wp + wr ) * denr + wi * deni ) / dnorm zpi = ( wi * denr - ( 1.0_wp + wr ) * deni ) / dnorm zpr = a_focus * zpr zpi = a_focus * zpi ! Z = Zp * exp(i*lon_pole) lpr = DEG2RAD * lon_pole zr = zpr * cos ( lpr ) - zpi * sin ( lpr ) zi = zpr * sin ( lpr ) + zpi * cos ( lpr ) ! stereographic inverse rmag = sqrt ( zr * zr + zi * zi ) lat = 9 0.0_wp - RAD2DEG * 2.0_wp * atan ( rmag ) if ( zr == 0.0_wp . and . zi == 0.0_wp ) then lon = lon_pole + 18 0.0_wp else lon = RAD2DEG * atan2 ( zi , zr ) end if ! wrap lon to [-180, 180) lon = modulo ( lon + 18 0.0_wp , 36 0.0_wp ) - 18 0.0_wp end subroutine bipolar_corner_latlon","tags":"","url":"proc/bipolar_corner_latlon.html"},{"title":"ocean_diffusive_number – Roundabout","text":"public pure function ocean_diffusive_number(kappa_h, dt_therm, dx_min) result(dnum) Two-axis explicit forward-Euler diffusive number kappa_h*dt_therm*(1/dx_min&#94;2+1/dy_min&#94;2) , conservatively\nevaluated at the SAME worst-case dx_min on both axes (matches\nthe “use the minimum cell” instruction; exact on an isotropic\nworst cell, strictly more conservative than using the true\nper-axis pair). dx_min<=0 returns 0. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: kappa_h real(kind=wp), intent(in) :: dt_therm real(kind=wp), intent(in) :: dx_min Return Value real(kind=wp) Called by proc~~ocean_diffusive_number~~CalledByGraph proc~ocean_diffusive_number ocean_diffusive_number proc~ocean_stability_audit ocean_stability_audit proc~ocean_stability_audit->proc~ocean_diffusive_number proc~engine_setup engine_setup proc~engine_setup->proc~ocean_stability_audit proc~complete_ocean_create complete_ocean_create proc~complete_ocean_create->proc~engine_setup proc~driver_run_ocean driver_run_ocean proc~driver_run_ocean->proc~engine_setup proc~driver_run driver_run proc~driver_run->proc~driver_run_ocean proc~rdb_ocean_create_finalize rdb_ocean_create_finalize proc~rdb_ocean_create_finalize->proc~complete_ocean_create proc~rdb_ocean_create_from_string rdb_ocean_create_from_string proc~rdb_ocean_create_from_string->proc~complete_ocean_create Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function ocean_diffusive_number ( kappa_h , dt_therm , dx_min ) result ( dnum ) !! Two-axis explicit forward-Euler diffusive number !! `kappa_h*dt_therm*(1/dx_min&#94;2+1/dy_min&#94;2)`, conservatively !! evaluated at the SAME worst-case `dx_min` on both axes (matches !! the \"use the minimum cell\" instruction; exact on an isotropic !! worst cell, strictly more conservative than using the true !! per-axis pair). `dx_min<=0` returns 0. real ( wp ), intent ( in ) :: kappa_h , dt_therm , dx_min real ( wp ) :: dnum if ( dx_min > 0.0_wp ) then dnum = kappa_h * dt_therm * ( 2.0_wp / dx_min ** 2 ) else dnum = 0.0_wp end if end function ocean_diffusive_number","tags":"","url":"proc/ocean_diffusive_number.html"},{"title":"ocean_diffusive_number_limit – Roundabout","text":"public pure function ocean_diffusive_number_limit() result(lim) Accessor for DIFFUSIVE_NUMBER_LIMIT . Arguments None Return Value real(kind=wp) Source Code pure function ocean_diffusive_number_limit () result ( lim ) !! Accessor for `DIFFUSIVE_NUMBER_LIMIT`. real ( wp ) :: lim lim = DIFFUSIVE_NUMBER_LIMIT end function ocean_diffusive_number_limit","tags":"","url":"proc/ocean_diffusive_number_limit.html"},{"title":"ocean_munk_delta_m – Roundabout","text":"public pure function ocean_munk_delta_m(nu_h, beta) result(delta_m) Munk boundary-layer width delta_M = (nu_h/beta)&#94;(1/3) . beta<=0 (f-plane — no meridional PV gradient, no Munk\nboundary layer) or nu_h<=0 returns huge(1.0_wp) (no\nconstraint — never trips the >= 2-cell criterion). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: nu_h real(kind=wp), intent(in) :: beta Return Value real(kind=wp) Called by proc~~ocean_munk_delta_m~~CalledByGraph proc~ocean_munk_delta_m ocean_munk_delta_m proc~ocean_munk_worst_case ocean_munk_worst_case proc~ocean_munk_worst_case->proc~ocean_munk_delta_m proc~ocean_stability_audit ocean_stability_audit proc~ocean_stability_audit->proc~ocean_munk_delta_m proc~ocean_stability_audit->proc~ocean_munk_worst_case proc~engine_setup engine_setup proc~engine_setup->proc~ocean_stability_audit proc~complete_ocean_create complete_ocean_create proc~complete_ocean_create->proc~engine_setup proc~driver_run_ocean driver_run_ocean proc~driver_run_ocean->proc~engine_setup proc~driver_run driver_run proc~driver_run->proc~driver_run_ocean proc~rdb_ocean_create_finalize rdb_ocean_create_finalize proc~rdb_ocean_create_finalize->proc~complete_ocean_create proc~rdb_ocean_create_from_string rdb_ocean_create_from_string proc~rdb_ocean_create_from_string->proc~complete_ocean_create Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function ocean_munk_delta_m ( nu_h , beta ) result ( delta_m ) !! Munk boundary-layer width `delta_M = (nu_h/beta)&#94;(1/3)`. !! `beta<=0` (f-plane — no meridional PV gradient, no Munk !! boundary layer) or `nu_h<=0` returns `huge(1.0_wp)` (no !! constraint — never trips the >= 2-cell criterion). real ( wp ), intent ( in ) :: nu_h , beta real ( wp ) :: delta_m if ( beta > 0.0_wp . and . nu_h > 0.0_wp ) then delta_m = ( nu_h / beta ) ** ( 1.0_wp / 3.0_wp ) else delta_m = huge ( 1.0_wp ) end if end function ocean_munk_delta_m","tags":"","url":"proc/ocean_munk_delta_m.html"},{"title":"ocean_munk_min_cells – Roundabout","text":"public pure function ocean_munk_min_cells() result(n) Accessor for MUNK_MIN_CELLS . Arguments None Return Value real(kind=wp) Source Code pure function ocean_munk