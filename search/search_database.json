ma_parse_lines proc~schema_parse nml_schema_t%schema_parse proc~schema_parse->proc~parse_file proc~read_config_from_string read_config_from_string proc~read_config_from_string->proc~read_config_from_string_impl proc~read_config_impl read_config_impl proc~read_config_impl->proc~schema_parse Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: ic Source Code pure function is_ident_char ( c ) result ( yes ) !! True for identifier characters (alnum + underscore). character , intent ( in ) :: c logical :: yes integer :: ic ic = iachar ( c ) yes = ( ic >= iachar ( \"a\" ) . and . ic <= iachar ( \"z\" )) . or . & ( ic >= iachar ( \"A\" ) . and . ic <= iachar ( \"Z\" )) . or . & ( ic >= iachar ( \"0\" ) . and . ic <= iachar ( \"9\" )) . or . & ( c == \"_\" ) end function is_ident_char","tags":"","url":"proc/is_ident_char.html"},{"title":"is_repeat_count – Roundabout","text":"private pure function is_repeat_count(word) result(yes) True if word looks like N*value (integer, then ‘*’). Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: word Return Value logical Called by proc~~is_repeat_count~~CalledByGraph proc~is_repeat_count is_repeat_count proc~check_unsupported check_unsupported proc~check_unsupported->proc~is_repeat_count proc~collect_tokens collect_tokens proc~collect_tokens->proc~check_unsupported proc~parse_group_body parse_group_body proc~parse_group_body->proc~collect_tokens proc~dispatch_group dispatch_group proc~dispatch_group->proc~parse_group_body proc~parse_from_lines parse_from_lines proc~parse_from_lines->proc~dispatch_group Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial character(len=1), private :: c integer, private :: i integer, private :: star Source Code pure function is_repeat_count ( word ) result ( yes ) !! True if `word` looks like `N*value` (integer, then '*'). character ( len =* ), intent ( in ) :: word logical :: yes integer :: star , i character :: c yes = . false . star = index ( word , \"*\" ) if ( star <= 1 ) return do i = 1 , star - 1 c = word ( i : i ) if ( c < \"0\" . or . c > \"9\" ) return end do yes = . true . end function is_repeat_count","tags":"","url":"proc/is_repeat_count.html"},{"title":"json_escape – Roundabout","text":"private pure function json_escape(s) result(out) Minimal JSON string escaping: backslash, double-quote, and the\ncommon control characters.  Doc/name/units strings in this\ncodebase are plain single-line ASCII, so this is deliberately\nnot a general-purpose escaper. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s Return Value character(len=:), allocatable Called by proc~~json_escape~~CalledByGraph proc~json_escape json_escape proc~json_string_array json_string_array proc~json_string_array->proc~json_escape proc~schema_render_json nml_schema_t%schema_render_json proc~schema_render_json->proc~json_escape proc~write_key_json write_key_json proc~schema_render_json->proc~write_key_json proc~write_key_json->proc~json_escape proc~write_key_json->proc~json_string_array Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial character(len=1), private :: c integer, private :: i Source Code pure function json_escape ( s ) result ( out ) !! Minimal JSON string escaping: backslash, double-quote, and the !! common control characters.  Doc/name/units strings in this !! codebase are plain single-line ASCII, so this is deliberately !! not a general-purpose escaper. character ( len =* ), intent ( in ) :: s character ( len = :), allocatable :: out integer :: i character :: c out = \"\" do i = 1 , len ( s ) c = s ( i : i ) select case ( c ) case ( '\"' ) out = out // '\\\"' case ( \"\\\") out = out//\" \\\\ \" case (achar(10)) out = out//\" \\ n \" case (achar(9)) out = out//\" \\ t \" case default if ( iachar ( c ) >= 32 ) out = out // c end select end do end function json_escape","tags":"","url":"proc/json_escape.html"},{"title":"json_fmt_real – Roundabout","text":"private pure function json_fmt_real(v) result(str) Real -> JSON number, robust to extreme magnitude (e.g. huge(wp) floor/ceiling sentinels like kv_max ’s default): fmt_real ’s E18.10 is too narrow for a 3-digit exponent and gfortran drops\nthe E literal to fit (“0.1797693135+309”), which is not valid\nJSON. ES.E3 explicitly requests a 3-digit exponent field, which\nforces the E to stay, at a width sized for the worst case. 16\nfraction digits (17 significant figures) is real64’s round-trip\nguarantee – one digit short (as an earlier version of this\nfunction used) rounds huge(wp) ’s text UP past the true maximum\nfinite double, so re-parsing it (e.g. Python’s json.load )\noverflows to infinity, which is not valid JSON and breaks the\ngenerator ( tools/gen_python_config.py ) that reads this file. Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: v Return Value character(len=:), allocatable Called by proc~~json_fmt_real~~CalledByGraph proc~json_fmt_real json_fmt_real proc~json_real_array json_real_array proc~json_real_array->proc~json_fmt_real proc~write_key_json write_key_json proc~write_key_json->proc~json_fmt_real proc~write_key_json->proc~json_real_array proc~schema_render_json nml_schema_t%schema_render_json proc~schema_render_json->proc~write_key_json Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial character(len=40), private :: buf Source Code pure function json_fmt_real ( v ) result ( str ) !! Real -> JSON number, robust to extreme magnitude (e.g. `huge(wp)` !! floor/ceiling sentinels like `kv_max`'s default): `fmt_real`'s !! `E18.10` is too narrow for a 3-digit exponent and gfortran drops !! the `E` literal to fit (\"0.1797693135+309\"), which is not valid !! JSON. `ES.E3` explicitly requests a 3-digit exponent field, which !! forces the `E` to stay, at a width sized for the worst case. 16 !! fraction digits (17 significant figures) is real64's round-trip !! guarantee -- one digit short (as an earlier version of this !! function used) rounds `huge(wp)`'s text UP past the true maximum !! finite double, so re-parsing it (e.g. Python's `json.load`) !! overflows to infinity, which is not valid JSON and breaks the !! generator (`tools/gen_python_config.py`) that reads this file. real ( rk ), intent ( in ) :: v character ( len = :), allocatable :: str character ( len = 40 ) :: buf write ( buf , \"(ES26.16E3)\" ) v str = trim ( adjustl ( buf )) end function json_fmt_real","tags":"","url":"proc/json_fmt_real.html"},{"title":"json_real_array – Roundabout","text":"private pure function json_real_array(arr) result(str) Render arr(:) as a comma-separated list of JSON numbers (no\nenclosing brackets). Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: arr (:) Return Value character(len=:), allocatable Calls proc~~json_real_array~~CallsGraph proc~json_real_array json_real_array proc~json_fmt_real json_fmt_real proc~json_real_array->proc~json_fmt_real Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an inte