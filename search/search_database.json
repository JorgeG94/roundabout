cfg % ocean % isopycnal % reset_vanished_u call g % add ( nml_logical ( \"reset_vanished_u\" , pl , & \"Zero face velocity when layer vanished on both adjacent cells\" )) pl => cfg % ocean % isopycnal % cfl_ignore_vanished call g % add ( nml_logical ( \"cfl_ignore_vanished\" , pl , & \"Exclude vanished layers from MaxCFL / panic / CFL truncation\" )) pl => cfg % ocean % isopycnal % pgf_skip_nonoverlap call g % add ( nml_logical ( \"pgf_skip_nonoverlap\" , pl , & \"Zero the face PGF where a grounded layer's z-extents do not \" // & \"overlap across the face (VCOORD_LAGRANGIAN only, mont / \" // & \"fv_lite / fv_wright / fv_mom6; default ON — kills the spurious \" // & \"at-rest grounded-layer pressure gradient)\" )) pl => cfg % ocean % isopycnal % conservative_floor call g % add ( nml_logical ( \"conservative_floor\" , pl , & \"Conservative min-thickness borrow (replaces the injecting angstrom_h floor)\" )) pl => cfg % ocean % isopycnal % check_h_positive call g % add ( nml_logical ( \"check_h_positive\" , pl , & \"DEBUG: abort on the first negative h_layer, naming the stage + (i,j,k)\" )) call schema % add_group ( g ) end subroutine register_ocean_isopycnal","tags":"","url":"proc/register_ocean_isopycnal.html"},{"title":"register_ocean_mpi – Roundabout","text":"private  subroutine register_ocean_mpi(cfg, schema) &ocean_mpi_nml : multi-rank MPI debug / tuning controls. Arguments Type Intent Optional Attributes Name type( config_t ), intent(in), target :: cfg type( nml_schema_t ), intent(inout) :: schema Calls proc~~register_ocean_mpi~~CallsGraph proc~register_ocean_mpi register_ocean_mpi proc~group_add nml_group_t%group_add proc~register_ocean_mpi->proc~group_add proc~nml_logical nml_logical proc~register_ocean_mpi->proc~nml_logical proc~schema_add_group nml_schema_t%schema_add_group proc~register_ocean_mpi->proc~schema_add_group error error proc~group_add->error proc~lower lower proc~group_add->proc~lower proc~schema_add_group->error proc~schema_add_group->proc~lowe