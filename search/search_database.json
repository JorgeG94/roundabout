 intent(inout) :: ms Multilayer C-grid state whose exchange-covered ghost bands are poisoned. type( barotropic_workstate_t ), intent(inout) :: bt_work BT workstate whose exchange-covered ghost bands are poisoned. type( ocean_surface_stress_t ), intent(inout) :: ss Surface-stress slot.  Its tau_x / tau_y bands became\nexchange-owned with the forcing-halo fix, so they are poisoned\nhere too — see the block at the end of the body. logical, intent(in) :: poison_w Poison west ghost band. .true. iff the west edge is exchange-owned\n(MPI seam or periodic-x). logical, intent(in) :: poison_e Poison east ghost band. .true. iff the east edge is exchange-owned. logical, intent(in) :: poison_s Poison south ghost band. .true. iff the south edge is exchange-owned. logical, intent(in) :: poison_n Poison north ghost band. .true. iff the north edge is exchange-owned. private  subroutine poison_centre_2d (fld, nxl, nyl, ng, qnan, pw, pe, ps, pn) Poison centre-type 2D ghost bands. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng,nyl+2*ng) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn private  subroutine poison_centre_3d (fld, nxl, nyl, ng, nz, qnan, pw, pe, ps, pn) Poison centre-type 3D ghost bands. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng,nyl+2*ng,nz) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng integer, intent(in) :: nz real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn private  subroutine poison_face_x_2d (fld, nxl, nyl, ng, qnan, pw, pe, ps, pn) Poison x-face 2D ghost bands.\nfld has shape (nx_total+1, ny_total) = (nxl+2 ng+1, nyl+2 ng).\nNEVER poison i = ng+1 (west seam face) or i = ng+nxl+1 (east seam face):\nthese carry ownership/wrap-direction asymmetries that make it unsafe\nto overwrite them.  West ghost faces: i = 1..ng.\nEast ghost faces: i = ng+nxl+2..nx_face.  Y-bands centre-type. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng+1,nyl+2*ng) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn private  subroutine poison_face_x_3d (fld, nxl, nyl, ng, nz, qnan, pw, pe, ps, pn) Poison x-face 3D ghost bands.  Seam-face exclusion: see poison_face_x_2d. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng+1,nyl+2*ng,nz) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng integer, intent(in) :: nz real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn private  subroutine poison_face_y_2d (fld, nxl, nyl, ng, qnan, pw, pe, ps, pn) Poison y-face 2D ghost bands.\nfld has shape (nx_total, ny_total+1) = (nxl+2 ng, nyl+2 ng+1).\nNEVER poison j = ng+1 (south seam face) or j = ng+nyl+1 (north seam face).\nSouth ghost faces: j = 1..ng.  North ghost faces: j = ng+nyl+2..ny_face.\nX-bands are centre-type: i = 1..ng and i = ng+nxl+1..nx_total. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng,nyl+2*ng+1) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn private  subroutine poison_face_y_3d (fld, nxl, nyl, ng, nz, qnan, pw, pe, ps, pn) Poison y-face 3D ghost bands.  Seam-face exclusion: see poison_face_y_2d. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: fld (nxl+2*ng,nyl+2*ng+1,nz) integer, intent(in) :: nxl integer, intent(in) :: nyl integer, intent(in) :: ng integer, intent(in) :: nz real(kind=wp), intent(in) :: qnan logical, intent(in) :: pw logical, intent(in) :: pe logical, intent(in) :: ps logical, intent(in) :: pn","tags":"","url":"module/rdb_ocean_ghost_poison.html"},{"title":"rdb_driver – Roundabout","text":"Owns the end-to-end compute-rank path that used to live inline in app/main.F90 : setup (decomp / state allocation / scatter / BC /\nforcing / nesting / output / GPU enter_data), the time-stepping\nloop (forcing update, solver_step, status print, snapshot output,\nrestart, gauges), and finalize (exit_data, final snapshot,\ndiagnostics, profiler report, resource cleanup). Exposed as driver_run(cfg) so:\n  * app/main.F90 stays thin (MPI init, argv parsing, dispatch).\n  * Unit tests can drive a full compute lifecycle from an in-code config_t , catching integration-level bugs (OpenACC partial\n    presence, init ordering, missing attaches) that per-kernel\n    unit tests miss. Uses pic_logger pic_strings rdb_console_stats rdb_ocean_boundary_types rdb_config rdb_halo rdb_comm_env pic_io rdb_ocean_console_stats rdb_profiler rdb_mem_report rdb_ocean_status rdb_io_netcdf rdb_constants pic_knowledge rdb_ocean_dyn pic_types rdb_ocean_engine rdb_banner rdb_ocean_state pic_timer module~~rdb_driver~~UsesGraph module~rdb_driver rdb_driver module~rdb_banner rdb_banner module~rdb_driver->module~rdb_banner module~rdb_comm_env rdb_comm_env module~rdb_driver->module~rdb_comm_env module~rdb_config rdb_config module~rdb_driver->module~rdb_config module~rdb_console_stats rdb_console_stats module~rdb_driver->module~rdb_console_stats module~rdb_constants rdb_constants module~rdb_driver->module~rdb_constants module~rdb_halo rdb_halo module~rdb_driver->module~rdb_halo module~rdb_io_netcdf rdb_io_netcdf module~rdb_driver->module~rdb_io_netcdf module~rdb_mem_report rdb_mem_report module~rdb_driver->module~rdb_mem_report module~rdb_ocean_boundary_types rdb