rge graphs. Source Code subroutine ocean_dyn_enter_data_impl ( this ) type ( ocean_dyn_t ), intent ( inout ) :: this call barotropic_workstate_enter_data_impl ( this % bt_work ) ! accel_visc_rem stage-entry snapshots: eagerly allocated at setup ! (host source=0) only when the knob is on, so `copyin` (not `create`) ! and gate on allocation — symmetric with the setup allocation and the ! exit_data delete. if ( allocated ( this % avr_u0 )) then !$acc enter data copyin(this%avr_u0, this%avr_v0) end if ! bt_wide is attached by ocean_dyn_enable_bt_wide (AFTER enter_data ! for the rest of dyn); no attach here — see ocean_dyn_enable_bt_wide. end subroutine ocean_dyn_enter_data_impl","tags":"","url":"proc/ocean_dyn_enter_data_impl.html"},{"title":"ocean_dyn_exit_data – Roundabout","text":"private  subroutine ocean_dyn_exit_data(this) Type Bound ocean_dyn_t Arguments Type Intent Optional Attributes Name class( ocean_dyn_t ), intent(inout) :: this Calls proc~~ocean_dyn_exit_data~~CallsGraph proc~ocean_dyn_exit_data ocean_dyn_t%ocean_dyn_exit_data proc~ocean_dyn_exit_data_impl ocean_dyn_exit_data_impl proc~ocean_dyn_exit_data->proc~ocean_dyn_exit_data_impl proc~barotropic_workstate_exit_data_impl barotropic_workstate_exit_data_impl proc~ocean_dyn_exit_data_impl->proc~barotropic_workstate_exit_data_impl proc~bt_wide_exit_data bt_wide_t%bt_wide_exit_data proc~ocean_dyn_exit_data_impl->proc~bt_wide_exit_data proc~bt_wide_exit_data_impl bt_wide_exit_data_impl proc~bt_wide_exit_data->proc~bt_wide_exit_data_impl proc~ocean_metrics_exit_data ocean_metrics_t%ocean_metrics_exit_data proc~bt_wide_exit_data_impl->proc~ocean_metrics_exit_data proc~ocean_metrics_exit_data_impl ocean_metrics_exit_data_impl proc~ocean_metrics_exit_data->proc~ocean_metrics_exit_data_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type P