nt(inout) :: fpr (nx,ny) real(kind=wp), intent(in) :: air_temp real(kind=wp), intent(in) :: restore_lambda real(kind=wp), intent(in) :: sw_down real(kind=wp), intent(in) :: snowfall integer, intent(in) :: nx integer, intent(in) :: ny Called by proc~~ice_atm_forcing_restoring_impl~~CalledByGraph proc~ice_atm_forcing_restoring_impl ice_atm_forcing_restoring_impl proc~ice_atm_forcing_restoring ice_atm_forcing_restoring proc~ice_atm_forcing_restoring->proc~ice_atm_forcing_restoring_impl proc~engine_step_ice engine_step_ice proc~engine_step_ice->proc~ice_atm_forcing_restoring proc~driver_run_ocean driver_run_ocean proc~driver_run_ocean->proc~engine_step_ice proc~rdb_ocean_step rdb_ocean_step proc~rdb_ocean_step->proc~engine_step_ice proc~driver_run driver_run proc~driver_run->proc~driver_run_ocean Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: j Source Code pure subroutine ice_atm_forcing_restoring_impl ( sf0 , dsfdt , sw , fpr , air_temp , & restore_lambda , sw_down , snowfall , nx , ny ) !! Full-array fill (incl. ghosts). Explicit-shape + decl-order (dims first). !! Runs on device-resident seam arrays (mapped by ice%enter_data). integer , intent ( in ) :: nx , ny real ( wp ), intent ( inout ) :: sf0 ( nx , ny ), dsfdt ( nx , ny ), sw ( nx , ny ), fpr ( nx , ny ) real ( wp ), intent ( in ) :: air_temp , restore_lambda , sw_down , snowfall integer :: i , j do concurrent ( j = 1 : ny , i = 1 : nx ) sf0 ( i , j ) = - restore_lambda * air_temp dsfdt ( i , j ) = restore_lambda sw ( i , j ) = sw_down fpr ( i , j ) = snowfall end do end subroutine ice_atm_forcing_restoring_impl","tags":"","url":"proc/ice_atm_forcing_restoring_impl.html"},{"title":"bdrag_variant_is_implemented – Roundabout","text":"public pure function bdrag_variant_is_implemented(code) result(ok) .true. only for a bottom-drag variant with a real kernel\n( BDRAG_LINEAR / BDRAG_QUADRATIC ). BDRAG_INVALID returns .false. .  The single gate validate_config consumes (PR-6). Arguments Type Intent Optional Attributes Name integer, intent(in) :: code Return Value logical Called by proc~~bdrag_variant_is_implemented~~CalledByGraph proc~bdrag_variant_is_implemented bdrag_variant_is_implemented proc~validate_config validate_config proc~validate_config->proc~bdrag_variant_is_implemented proc~build_pending_handle build_pending_handle proc~build_pending_handle->proc~validate_config proc~rdb_ocean_create_from_string rdb_ocean_create_from_string proc~rdb_ocean_create_from_string->proc~build_pending_handle proc~rdb_ocean_create_pending rdb_ocean_create_pending proc~rdb_ocean_create_pending->proc~build_pending_handle Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\