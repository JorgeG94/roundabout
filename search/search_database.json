ator; registry contributors are counted by their owning slot) slot (0 when !! unallocated). class ( ocean_budgets_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = arr_bytes ( this % areaT ) ! Region mask — HOST-only (lazily allocated by `init_snapshot` / ! `evaluate`, never `!$acc enter data`'d).  Counted anyway now that ! `diag_mask_t` has a `bytes()`: the term is 0 on every shipped ! namelist (`ocean_budgets_t` has no production consumer) and keeping ! it makes the drift hook's \"every countable component\" rule hold. if ( allocated ( this % mask )) nbytes = nbytes + this % mask % bytes () end function ocean_budgets_bytes","tags":"","url":"proc/ocean_budgets_bytes.html"},{"title":"budget_area_field – Roundabout","text":"private  subroutine budget_area_field(this, areaT) Per-cell T-area (m²) for physical integrals: cached metrics areaT once set_area has run, else uniform grid%dx·grid%dy . Arguments Type Intent Optional Attributes Name type( ocean_budgets_t ), intent(in) :: this real(kind=wp), intent(out), allocatable :: areaT (:,:) Called by proc~~budget_area_field~~CalledByGraph proc~budget_area_field budget_area_field proc~ocean_budgets_drain_contributors ocean_budgets_t%ocean_budgets_drain_contributors proc~ocean_budgets_drain_contributors->proc~budget_area_field proc~ocean_budgets_evaluate ocean_budgets_t%ocean_budgets_evaluate proc~ocean_budgets_evaluate->proc~budget_area_field proc~ocean_budgets_init_snapshot ocean_budgets_t%ocean_budgets_init_snapshot proc~ocean_budgets_init_snapshot->proc~ocean_budgets_evaluate Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine budget_area_field ( this , areaT ) !! Per-cell T-area (m²) for physical integrals: cached metrics `areaT` !! once `set_area` has run, else uniform `grid%dx·grid%dy`. type ( ocean_budgets_t ), intent ( in ) :: this real ( wp ), allocatable , intent ( out ) :: areaT (:, :) if ( allocated ( this % areaT )) then areaT = this % areaT else allocate ( areaT ( this % grid % nx_total , this % grid % ny_total ), & source = this % grid % dx * this % grid % dy ) end if end subroutine budget_area_field","tags":"","url":"proc/budget_area_field.html"},{"title":"ocean_budgets_destroy – Roundabout","text":"private  subroutine ocean_budgets_destroy(this) Type Bound ocean_budgets_t Arguments Type Intent Optional Attributes Name class( ocean_budgets_t ), intent(inout) :: this Calls proc~~ocean_budgets_destroy~~CallsGraph proc~ocean_budgets_destroy ocean_budgets_t%ocean_budgets_destroy proc~diag_mask_destroy diag_mask_destroy proc~ocean_budgets_destroy->proc~diag_mask_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i Source Code subroutine ocean_budgets_destroy ( this ) class ( ocean_budgets_t ), intent ( inout ) :: this integer :: i this % is_init = . false . this % nbudgets = 0 this % values = 0.0_wp this % values_init = 0.0_wp this % has_snapshot = . false . if ( allocated ( this % areaT )) deallocate ( this % areaT ) if ( allocated ( this % mask )) then call diag_mask_destroy ( this % mask ) deallocate ( this % mask ) end if if ( allocated ( this % contributors )) then do i = 1 , this % n_contributors nullify ( this % contributors ( i )% per_cell ) end do deallocate ( this % contributors ) end if this % n_contributors = 0 this % n_contributors_max = 0 end subroutine ocean_budgets_destroy","tags":"","url":"proc/ocean_budgets_destroy.html"},{"title":"ocean_budgets_drain_contributors – Roundabout","text":"private  subroutine ocean_budgets_drain_contributors(this) For each contributor: integrate per_cell·mask·areaT (over k) into total_integrated , then zero per_cell for the next window. Type Bound ocean_budgets_t Arguments Type Intent Optional Attributes Name class( ocean_budgets_t ), intent(inout) :: this Calls proc~~ocean_budgets_drain_contributors~~CallsGraph proc~ocean_budgets_drain_contributors ocean_budgets_t%ocean_budgets_drain_contributors proc~budget_area_field budget_area_field proc~ocean_budgets_drain_contributors->proc~budget_area_field proc~diag_mask_global diag_mask_global proc~ocean_budgets_drain_contributors->proc~diag_mask_global proc~recompute_total_area recompute_total_area proc~diag_mask_global->proc~recompute_total_area Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, allocatable :: areaT (:,:) real(kind=wp), private :: col_sum integer, private :: i integer, private :: ic real(kind=wp), private :: increment integer, private :: j integer, private :: k integer, private :: nx integer, private :: ny integer, private :: nz real(kind=wp), private :: w_dA Source Code subroutine ocean_budgets_drain_contributors ( this ) !! For each contributor: integrate `per_cell·mask·areaT` (over k) into !! `total_integrated`, then zero `per_cell` for the next window. class ( ocean_budgets_t ), intent ( inout ) :: this integer :: ic , i , j , k , nx , ny , nz real ( wp ) :: w_dA , col_sum , increment real ( wp ), allocatable :: areaT (:, :) if (. not . this % is_init ) return if (. not . allocated ( this % mask )) then allocate ( this % mask , source = diag_mask_global ( this % grid )) end if call budget_area_field ( this , areaT ) do ic = 1 , this % n_contributors associate ( c => this % contributors ( ic )) if (. not . c % is_active ) cycle if (. not . associated ( c % per_cell )) cycle if ( c % device_resident ) then !$acc update self(c%per_cell) if_present end if nx = min ( this % mask % nx , size ( c % per_cell , 1 )) ny = min ( this % mask % ny , size ( c % per_cell , 2 )) nz = size ( c % per_cell , 3 ) increment = 0.0_wp do j = 1 , ny do i = 1 , nx w_dA = this % mask % weight ( i , j ) * areaT ( i , j ) if ( w_dA <= 0.0_wp ) cycle col_sum = 0.0_wp do k = 1 , nz col_sum = col_sum + c % per_cell ( i , j , k ) end do increment = increment + w_dA * col_sum end do end do c % total_integrated = c % total_integrated + increment c % per_cell = 0.0_wp if ( c % device_resident ) then !$acc update device(c%per_cell) if_present end if end associate end do e