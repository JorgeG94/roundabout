ors:\" ) call logger % info ( \"    Jorge Luis Galvez Vallejo\" ) call logger % info ( \"    Albert Sietze Thie\" ) ! add your name here after you've contributed! call logger % info ( \"\" ) call get_knowledge () end subroutine print_banner","tags":"","url":"proc/print_banner.html"},{"title":"profiler_get_time – Roundabout","text":"public  function profiler_get_time(name) result(t) Accumulated time (s) for a named region. Public for the unit-test suite only. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Return Value real(kind=dp) Variables Type Visibility Attributes Name Initial integer, private :: idx Source Code function profiler_get_time ( name ) result ( t ) !! Accumulated time (s) for a named region. Public for the unit-test suite only. character ( len =* ), intent ( in ) :: name real ( dp ) :: t integer :: idx t = 0.0_dp do idx = 1 , state % num_regions if ( trim ( state % regions ( idx )% name ) == trim ( name )) then t = state % regions ( idx )% total_time return end if end do end function profiler_get_time","tags":"","url":"proc/profiler_get_time.html"},{"title":"find_or_create_region – Roundabout","text":"private  function find_or_create_region(name) result(idx) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Return Value integer Called by proc~~find_or_create_region~~CalledByGraph proc~find_or_create_region find_or_create_region proc~profiler_start profiler_start proc~profiler_start->proc~find_or_create_region proc~barotropic_substep_nonlinear barotropic_substep_nonlinear proc~barotropic_substep_nonlinear->proc~profiler_start proc~bt_wide_entry_exchange_impl bt_wide_entry_exchange_impl proc~bt_wide_entry_exchange_impl->proc~profiler_start proc~continuity_tracer_step_split continuity_tracer_step_split proc~continuity_tracer_step_split->proc~profiler_start proc~driver_run_ocean driver_run_ocean proc~driver_run_ocean->proc~profiler_start proc~engine_step engine_step proc~driver_run_oce