! Multi-layer baroclinic instability — the 2-layer test scaled to ocean-like
! vertical resolution (nz=15 continuous stratification) + a larger domain.
! Confirms the clean baroclinic-eddy life cycle survives the jump from the
! minimal 2-layer (Phillips) to a depth-resolved continuous front.
!
! 768 x 384 km periodic-x channel, 2 km, nz=15, H=2000 m (Ld ~ 18 km ~ 9 cells).
!
! EXPECTED: same signature as the 2-layer, richer field — exponential growth,
! onset ~day 16-20, SATURATION by ~day 36 at En ~ 0.42 (higher than 2-layer's
! ~0.09: more layers + depth resolve more of the eddy cascade).  MaxCFL ~0.23,
! mass exact.  Unforced => slow decay after the peak.
!
! ~21 min for 50 days on a single V100 (1.1M cells); solver ~59 Mcells/s
! diag-off, ~32 with this (lean) diag on.

&sim_nml
   sim_type = "ocean"
/
&grid_nml
   nx = 384
   ny = 192
   dx = 2000.0
   dy = 2000.0
   nghost = 3
/
&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/
&time_nml
   t_end        = 4320000.0   ! 50 days
   dt_fixed     = 120.0
   cfl_interval = 1
/
&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/
&nonhydrostatic_nml
   nz_layers = 15
/
&vcoord_nml
   vcoord_type = "sigma"
/
&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 10.0
/
&ocean_coriolis_nml
   form = "sadourny"
/
&ocean_topo_nml
   topo_config    = "flat"
   max_depth      = 2000.0
   wind_config    = "constant"
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/
&ocean_ic_nml
   ic_config      = "eady"
   alpha_T        = 0.17
   rho_0          = 1035.0
   eady_dT_dz     = 0.005
   eady_dT_dy     = -2.0e-5
   eady_T_ref     = 10.0
   eady_pert_amp  = 1.0e-2
   eady_pert_seed = 12345
/
&ocean_pgf_nml
   maxvel = 2.0
/
&ocean_hvisc_nml
   nu_h = 80.0
/
&ocean_bt_nml
   ! Fixed n_inner=24 satisfies the 2-D CFL at H=2000m (c_ext~140, CFL~0.83)
   ! regardless of build; auto_n_inner=.true.+cfl_bt_safety=0.65 also works
   ! once feat/ocean-bt-cfl-2d is merged.
   n_inner = 24
   bebt    = 0.2
/
&ocean_diag_nml
   ! 12-hourly cadence keeps the I/O modest (the dominant cost is
   ! frames x layers); the animation uses the surface (top) layer.
   enabled  = .true.
   filename = "bci_15layer"
   dt_out   = 43200.0
   vgrid    = "layer"
/
&output_nml
   output_dir     = "./out_bci_15layer"
   output_to_file = .false.
/
&logging_nml
   status_interval = 86400.0
/
