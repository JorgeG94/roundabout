! Coriolis-at-a-coast — static land-mask ENERGY test (CHUNK B / C1).
!
! Goal: the C1 numerical question — does the free-slip wet_q masking of
! the corner relative vorticity keep the Coriolis term ~energy-conserving
! at a coastline?  A rotating (f /= 0) closed basin with an interior
! island and a wind-spun-up flow that develops vorticity near the coast.
!
! Setup:
!   * 48 x 48 basin @ 5 km, f-plane f = 1e-4 1/s (mid-latitude rotation).
!   * topo_config = "island": flat 1000 m basin, central LAND square.
!   * Uniform T/S (no APE) so total energy = KE only; a clean budget.
!   * Eastward wind 0.05 N/m² spins up a gyre that wraps the island and
!     builds relative vorticity at the free-slip corners (wet_q = 0).
!
! Expected outcome (orchestrator GPU check):
!   * Free-slip default: KE does NOT grow spuriously over the run beyond
!     the wind-input / drag-dissipation balance — the masked rel-vort at
!     land corners adds no energy.  Track domain-integrated KE; after the
!     wind-up transient it should plateau / decay, not grow unbounded.
!   * No-normal-flow + mass conservation hold exactly (as flow_past_island).
!
! DEFAULT-SADOURNY COASTAL-KE CAVEAT (document, do not fail on it):
!   The production velocity-form SADOURNY Coriolis builds (zeta+f)*v_avg,
!   NOT the transport-form q*vh.  With land it is mass-conserving and
!   free-slip-correct, but its KE-antisymmetry across a coast is only
!   APPROXIMATE — a small coastal energy-budget residual is expected and
!   is the existing-class enstrophy-vs-energy imperfection, not a bug.
!   For STRICT coastal energy conservation switch form = "sadourny_hk"
!   (transport form: mass fluxes ride the zeroed metrics, exact).  This
!   nml ships the default Sadourny to exercise the common path; the
!   orchestrator may re-run with sadourny_hk to confirm the tighter
!   energy bound.
!
! 48 x 48 x 4 = ~9k cells.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 48
   ny     = 48
   dx     = 5000.0
   dy     = 5000.0
   nghost = 2
/

&time_nml
   t_end        = 864000.0    ! 10 days
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   ! 0.05 N/m^2 eastward — the wind this case's own header promises.
   ! It was previously set on &ocean_topo_nml taux_magnitude, which is
   ! INERT under wind_config="constant" (that knob is only read by the
   ! 2gyre/neverworld2 profiles), so the case ran its full 10 days at
   ! En = 0.000E+00 and never spun up the gyre it describes.
   wind_stress_x = 0.05
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 4
/

&vcoord_nml
   vcoord_type = "sigma"
/

&tracer_nml
   initial_temperature = 15.0
   initial_salinity    = 35.0
   T_init_surface      = 0.0
   T_init_bottom       = 0.0
/

&ocean_coriolis_nml
   form = "sadourny"    ! default velocity-form; see KE caveat above (use sadourny_hk for strict energy)
/

&ocean_hvisc_nml
   nu_h    = 50.0
   no_slip = .false.    ! free-slip (default)
/

&ocean_bdrag_nml
   form = "linear"
   r    = 2.5e-5
   hbbl = 10.0
   bg_vel = 0.1
/

&ocean_topo_nml
   topo_config    = "island"
   max_depth      = 1000.0
   slope_scale    = 0.2
   wind_config    = "constant"
   taux_magnitude = 0.05
   coriolis_beta  = 0.0
/

&ocean_vmix_nml
   use_closure = .false.
   use_kpp     = .false.
/

&ocean_bt_nml
   n_inner = 30
/

&ocean_diag_nml
   enabled  = .true.
   filename = "coriolis_coast"
   dt_out   = 43200.0
/

&output_nml
   output_dir     = "./out_coriolis_coast"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 43200.0
/
