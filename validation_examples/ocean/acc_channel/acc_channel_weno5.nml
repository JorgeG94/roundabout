! Idealized ACC channel — WENO5 windowed-drain tracer advection.
!
! Identical physics to acc_channel.nml (the canonical forced showcase)
! EXCEPT the horizontal tracer advection is decoupled from the per-step
! dynamics and run once per WINDOW with a WENO5-Z face reconstruction:
!
!   &ocean_vmix_nml
!     tracer_recon            = 'weno5'   ! WENO5-Z swept-average drain
!     dt_tracer_advect_ratio  = 2         ! REQUIRED: the drain only fires
!                                         !   at ratio > 1; at 1 it runs
!                                         !   every step and WENO is a no-op
!     dt_therm_ratio          = 2         ! must be an integer multiple of
!                                         !   dt_tracer_advect_ratio (fail-loud)
!
! WENO engages ONLY inside the windowed drain — with ratio=1 the tracer
! advection runs every dynamic step (PPM/CW split) and tracer_recon is
! never consulted.  nghost=3 (inherited from the periodic-x base) already
! satisfies the weno5 halo requirement; weno7 needs nghost>=4, weno9 >=5
! (all fail-loud at configure).  This is the SEPARATE ocean knob in
! &ocean_vmix_nml, independent of the coastal &tracer_nml tracer_recon.
!
! Expected: sharper T/S fronts in the windowed-advected tracers vs the
! PPM base, no new tracer extrema (monotone Z-weights), salt/heat within
! physical bounds.  A regression here (NaN / T,S blowup) is a real finding
! — acc_channel has caught genuine regressions before.
!
! Grid: this variant runs at a REDUCED resolution (120 x 70 x 20) vs the
! canonical acc_channel.nml (480 x 280 x 75).  The full-res showcase maps
! ~14 GB of ocean state and grows the lazy kernel workspaces past 32 GB,
! so it does NOT fit on a single 32 GB V100 (it OOMs at the first kernel
! launch — a pre-existing case-sizing property, NOT a WENO effect: the
! stock PPM acc_channel.nml OOMs identically).  120 x 70 x 20 fits (~0.8 GB
! at setup, ~23 GB peak with workspaces) and runs in ~3 s — enough to
! exercise the WENO drain end-to-end.  Scale nx/ny/nz back up on a
! larger-memory GPU (A100/H100) for the full showcase.
!
! Run:
!   cd validation_examples/ocean/acc_channel
!   # first load your NVHPC + NetCDF toolchain (module load / spack / conda;
!   # see environments/) -- one toolchain per shell, never stack two
!   CUDA_VISIBLE_DEVICES=<gpu> ../../../build_gpu/rdb acc_channel_weno5.nml

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 120
   ny     = 70
   dx     = 0.2
   dy     = 0.2
   nghost = 3
/

&ocean_grid_nml
   grid_config     = "spherical"
   lon_west        = 0.0
   lat_south       = -52.0
   rad_earth       = 6371000.0
   coriolis_scheme = "planetary"
   omega           = 7.2921e-5
/

&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/

&time_nml
   t_end        = 1.0
   time_unit    = "day"
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.12
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 20
/

&vcoord_nml
   vcoord_type = "zstar"
/

&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 8.0
   T_init_surface = 8.0
   T_init_bottom  = 2.0
/

&ocean_ic_nml
   alpha_T = 0.2
   rho_0   = 1035.0
/

&ocean_thermo_nml
   enable_thermodynamics = .true.
   q_heat = -40.0
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 3000.0
   edge_depth     = 1500.0
   slope_scale    = 3.0
   wind_config    = "constant"
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_pgf_nml
   form   = "fv_lite"
   maxvel = 2.0
/

&ocean_hvisc_nml
   nu_h            = 10000.0
   lateral_closure = "smagorinsky"
   c_smag          = 0.15
   kh_vel_scale    = 3.0e-3
   ah_max          = 1.0e4
   smag_ah         = .true.
   smag_bi_const   = 0.06
   nu_4_bg         = 0.0
   nu_4_max        = 1.0e12
/

&ocean_bdrag_nml
   form          = "linear"
   r             = 2.5e-5
   hbbl          = 10.0
   bg_vel        = 0.1
   bbl_thick_min = 0.1
/

&ocean_vmix_nml
   use_closure    = .true.
   use_kpp        = .false.
   kv_ml_invz2    = 0.01
   hmix_fixed     = 20.0
   harmonic_visc  = .true.
   ! Windowed-drain tracer advection with WENO5 reconstruction:
   tracer_recon           = 'weno5'
   dt_tracer_advect_ratio = 2
   dt_therm_ratio         = 2
/

&ocean_epbl_nml
   enable             = .true.
   mstar_scheme       = "om4"
   mld_use_prev_guess = .true.
   tke_diags          = .false.
   use_lt             = .false.
/

&ocean_kappa_shear_nml
   enable = .true.
/

&ocean_bt_nml
   ! PINNED, and LOAD-BEARING: since 2026-09-14 "ssp_rk2" is NOT the
   ! default (pred_corr is), so without this line the file would not run.
   ! The pred_corr v1 envelope refuses dt_tracer_advect_ratio > 1 (the predictor's
   ! TR_MODE_NONE + window accounting is unexercised) -- a fail-loud
   ! `validate_config` error, not a silent downgrade. This file's subject IS
   ! the windowed tracer-advect drain, so the pin is what keeps the stability
   ! suite's outer-split axis (tests/regression/stability_manifest.py) from
   ! building an impossible pred_corr twin of it. Lifting the pin needs the
   ! windowed path wired through the predictor-corrector loop.
   split_scheme = "ssp_rk2"
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
   bebt          = 0.2
/

&ocean_diag_nml
   enabled  = .true.
   filename = "acc_channel_weno5"
   dt_out   = 1.0
/

&output_nml
   output_dir     = "./out_acc_channel_weno5"
   output_to_file = .false.
/

&logging_nml
   status_interval = 1.0
/
