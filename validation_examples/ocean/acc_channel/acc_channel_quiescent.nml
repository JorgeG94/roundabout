! Quiescent ACC channel — the SPHERICAL tier-1.5 trap variant.
!
! SAME grid / seamount bathymetry / periodic-x BCs / closures (EPBL +
! kappa-shear ON) as acc_channel.nml, but ZERO wind, ZERO surface heat
! flux, and UNIFORM T,S (no available potential energy).  This is the
! honest tier-1.5 trap for a sigma/zstar dyn-core: with no APE the
! resting state MUST stay identically at rest — max|u|,|v| < ~1e-10 m/s
! over 5 days.  Any drift here is a real finding (metric/PGF
! inconsistency on the spherical grid at the ridge, or a periodic-seam
! metric issue), NOT a tuning target.
!
! VERIFIED (2026-06-11, V100): max|u|,|v| = 1.0e-11 / 5.5e-12 m/s,
! En = 6e-25 J, MaxCFL = 0 — passes at roundoff.  The spherical
! metrics + planetary Coriolis + periodic-x seam + seamount bathymetry
! are mutually consistent.
!
! NOTE: a STRATIFIED resting state over the seamount (the acc_channel
! T(z) IC with zero forcing) does NOT stay at rest — it drifts to
! ~0.16 m/s over the ridge crest.  That is the well-known sigma/zstar
! PGF residual over a slope under stratification (APE-over-slope), not
! a metric/seam bug: the drift is centred on the ridge, decays smoothly
! to ~2e-4 at the periodic seam and the walls, and is reproduced
! IDENTICALLY on a Cartesian-grid control (so it is not spherical-
! specific).  The seamount setter's own docstring specifies "uniform
! T,S, no APE" for the zero-motion expectation; this trap honours that.
!
! Run:
!   cd validation_examples/ocean/acc_channel
!   # first load your NVHPC + NetCDF toolchain (module load / spack / conda;
!   # see environments/) -- one toolchain per shell, never stack two
!   CUDA_VISIBLE_DEVICES=<gpu> ../../../build/rdb acc_channel_quiescent.nml

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 48
   ny     = 28
   dx     = 0.5
   dy     = 0.5
   nghost = 3
/

&ocean_grid_nml
   grid_config     = "spherical"
   lon_west        = 0.0
   lat_south       = -52.0
   rad_earth       = 6371000.0
   coriolis_scheme = "planetary"
   omega           = 7.2921e-5
/

&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/

&time_nml
   t_end        = 5.0
   time_unit    = "day"
   dt_fixed     = 1200.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0      ! no wind
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 16
/

&vcoord_nml
   vcoord_type = "zstar"
/

&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 8.0
   ! Uniform T,S (T_init_surface == T_init_bottom => no profile built):
   ! no APE, so the resting state is the true zero-motion trap.
   T_init_surface = 8.0
   T_init_bottom  = 8.0
/

&ocean_ic_nml
   alpha_T = 0.2
   rho_0   = 1035.0
/

&ocean_thermo_nml
   enable_thermodynamics = .true.
   q_heat = 0.0             ! no surface cooling
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 3000.0
   edge_depth     = 1500.0
   slope_scale    = 3.0
   wind_config    = "constant"
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_pgf_nml
   maxvel = 2.0
/

&ocean_hvisc_nml
   nu_h            = 10000.0
   lateral_closure = "smagorinsky"
   c_smag          = 0.15
   kh_vel_scale    = 3.0e-3
   ah_max          = 1.0e4
   smag_ah         = .true.
   smag_bi_const   = 0.06
   nu_4_bg         = 0.0
   nu_4_max        = 1.0e12
/

&ocean_bdrag_nml
   form          = "linear"
   r             = 2.5e-5
   hbbl          = 10.0
   bg_vel        = 0.1
   bbl_thick_min = 0.1
/

&ocean_vmix_nml
   use_closure    = .true.
   use_kpp        = .false.
   kv_ml_invz2    = 0.01
   hmix_fixed     = 20.0
   harmonic_visc  = .true.
   dt_therm_ratio = 1
/

&ocean_epbl_nml
   enable             = .true.
   mstar_scheme       = "om4"
   mld_use_prev_guess = .true.
   tke_diags          = .false.
   use_lt             = .false.
/

&ocean_kappa_shear_nml
   enable = .true.
/

&ocean_bt_nml
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
   bebt          = 0.2
/

&ocean_diag_nml
   enabled  = .true.
   filename = "acc_channel_quiescent"
   dt_out   = 1.0
/

&output_nml
   output_dir     = "./out_acc_channel_quiescent"
   output_to_file = .false.
/

&logging_nml
   status_interval = 1.0
/
