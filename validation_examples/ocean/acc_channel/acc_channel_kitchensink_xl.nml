! ACC channel "KITCHEN SINK XL" — the kitchen-sink stack grown for a
! heavier profiling/benchmark workload.  Same physics as
! acc_channel_kitchensink.nml; only the problem SIZE changes:
!
!   horizontal:  120 x 70 @ 0.2 deg  ->  240 x 140 @ 0.1 deg   (4x cells)
!   vertical:    nz = 90 (unchanged from the grown kitchensink)
!   => 240 x 140 x 90 = 3.02M cells (4x the 0.756M kitchensink)
!
! Two CFL limits move when you refine horizontally; both are handled here
! so it does NOT break:
!   * Biharmonic CFL  nu4·dt·((pi/dx)^2+(pi/dy)^2)^2 <= 2  tightens as
!     dx^-4.  At 0.1 deg / dt=600 the ceiling is ~1.3e11, so nu_4_max is
!     dropped 1e12 -> 1e11 (was just under the limit at 0.2 deg).
!   * Advective MaxCFL ~doubles (still well under the cfl_trunc=0.5 net);
!     dt=600 stays stable.  The barotropic auto_n_inner self-adjusts
!     (more substeps), which adds cost for free.
! Laplacian nu_h=500 stays far under its CFL at 0.1 deg.
!
! NOT a validation target — coverage/benchmark only (see the kitchensink
! header for the FK + windowed-advect tracer-leak caveat).
!
! Run:
!   cd validation_examples/ocean/acc_channel
!   # first load your NVHPC + NetCDF toolchain (module load / spack / conda;
!   # see environments/) -- one toolchain per shell, never stack two
!   CUDA_VISIBLE_DEVICES=<gpu> ../../../build/rdb acc_channel_kitchensink_xl.nml
! Profile:  nsys profile -t nvtx,openacc -o ks_xl <the above>

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 240
   ny     = 140
   dx     = 0.1
   dy     = 0.1
   nghost = 3
/

&ocean_grid_nml
   grid_config     = "spherical"
   lon_west        = 0.0
   lat_south       = -52.0
   rad_earth       = 6371000.0
   coriolis_scheme = "planetary"
   omega           = 7.2921e-5
/

&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/

&time_nml
   t_end        = 1.0
   time_unit    = "day"
   dt_fixed     = 600.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.12
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 90
/

&vcoord_nml
   vcoord_type   = "zstar"
   remap_method  = "ppm_h4"
/

&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 8.0
   T_init_surface = 8.0
   T_init_bottom  = 2.0
/

&ocean_ic_nml
   alpha_T = 0.2
   rho_0   = 1035.0
/

&ocean_tracers_nml
   enable_ideal_age = .true.
/

&ocean_thermo_nml
   enable_thermodynamics = .true.
   q_heat = -40.0
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 3000.0
   edge_depth     = 1500.0
   slope_scale    = 3.0
   wind_config    = "constant"
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_pgf_nml
   form      = "fv_lite"
   maxvel    = 2.0
   cfl_trunc = 0.5
/

&ocean_hvisc_nml
   nu_h            = 500.0
   lateral_closure = "smagorinsky"
   c_smag          = 0.15
   kh_vel_scale    = 3.0e-3
   ah_max          = 1.0e4
   smag_ah         = .true.
   smag_bi_const   = 0.06
   nu_4_bg         = 0.0
   nu_4_max        = 1.0e11   ! lowered from 1e12 for the 0.1 deg biharmonic CFL
/

&ocean_bdrag_nml
   form          = "linear"
   r             = 2.5e-5
   hbbl          = 10.0
   bg_vel        = 0.1
   bbl_thick_min = 0.1
/

&ocean_vmix_nml
   use_closure    = .true.
   use_kpp        = .false.
   kv_ml_invz2    = 0.01
   hmix_fixed     = 20.0
   harmonic_visc  = .true.
   dt_therm_ratio         = 2
   dt_tracer_advect_ratio = 2
/

&ocean_epbl_nml
   enable             = .true.
   mstar_scheme       = "om4"
   mld_use_prev_guess = .true.
   tke_diags          = .false.
   use_lt             = .false.
/

&ocean_kappa_shear_nml
   enable = .true.
/

&ocean_foxkemper_nml
   enable          = .true.
   use_mom_mixrate = .true.
   mld_decay_time  = 86400.0
/

&ocean_geothermal_nml
   enable = .true.
   q_geo  = 0.1
/

&ocean_wavespeed_nml
   enable      = .true.
   n_wavespeed = 1
/

&ocean_bt_nml
   ! PINNED, and LOAD-BEARING: since 2026-09-14 "ssp_rk2" is NOT the
   ! default (pred_corr is), so without this line the file would not run.
   ! The pred_corr v1 envelope refuses dt_tracer_advect_ratio > 1 (the predictor's
   ! TR_MODE_NONE + window accounting is unexercised) -- a fail-loud
   ! `validate_config` error, not a silent downgrade. This file's subject IS
   ! the windowed tracer-advect drain, so the pin is what keeps the stability
   ! suite's outer-split axis (tests/regression/stability_manifest.py) from
   ! building an impossible pred_corr twin of it. Lifting the pin needs the
   ! windowed path wired through the predictor-corrector loop.
   split_scheme = "ssp_rk2"
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
   bebt          = 0.2
/

&ocean_diag_nml
   enabled  = .false.
   filename = "acc_channel_kitchensink_xl"
   dt_out   = 1.0
/

&output_nml
   output_dir     = "./out_acc_channel_kitchensink_xl"
   output_to_file = .false.
/

&logging_nml
   status_interval = 1.0
/
