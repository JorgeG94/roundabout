! Island-at-rest — static land-mask quiescent trap (Tier-1.5).
!
! Goal: the headline correctness test for the ocean static land-mask
! foundation (CHUNK A).  A small closed basin with an interior LAND
! block, uniform density (zero APE), zero velocity, no forcing.  With the
! land mask correct (the 6 face metrics zeroed at every land face, land
! T-cells held at finite reference state), the only physical solution is
! IDENTICALLY ZERO MOTION FOREVER.
!
! Setup:
!   * 32 x 32 closed basin @ 5 km (160 km square).
!   * topo_config = "island": flat 1000 m basin with a central LAND
!     square (b = 0 < LAND_DEPTH_THRESHOLD).  slope_scale carries the
!     half-fraction = 0.2 ⇒ the middle 40 % (cells ~7..26) is land.
!   * 4 sigma layers (no remap; pure dyn-core under the mask).
!   * Uniform T = 15 C, S = 35 PSU — density horizontally + vertically
!     uniform ⇒ no APE, the BPG over uniform rho cancels exactly.
!   * f-plane f = 0 — no Coriolis feedback from residual flow.
!   * No wind, no surface flux, no sponges.  Closed walls all sides.
!
! Expected outcome (document for the orchestrator GPU run):
!   * max|u|, max|v|, max|eta| stay at machine round-off for the whole
!     run (no spurious coastline PGF / flux / vorticity).
!   * Mass conserved to ~1e-13 (the wet domain is closed: zero transport
!     through every land face).
!   * Any growth = a land-mask bug (un-zeroed metric, missing velocity
!     reset, contaminated PPM h_face next to the coast — CHUNK B).
!
! Tiny on purpose: 32 x 32 x 4 = 4096 cells; runs in seconds.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 32
   ny     = 32
   dx     = 5000.0
   dy     = 5000.0
   nghost = 2
/

&time_nml
   t_end        = 864000.0    ! 10 days
   dt_fixed     = 300.0       ! 5 min outer
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 0.0
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 4
/

&vcoord_nml
   vcoord_type = "sigma"
/

&tracer_nml
   initial_temperature = 15.0
   initial_salinity    = 35.0
   T_init_surface      = 0.0
   T_init_bottom       = 0.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config    = "island"
   max_depth      = 1000.0    ! Basin depth
   slope_scale    = 0.2       ! Island half-fraction (middle 40% is land)
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

&ocean_hvisc_nml
   nu_h = 0.0
   nu_4 = 0.0
/

&ocean_vmix_nml
   use_closure = .false.
   use_kpp     = .false.
/

&ocean_bt_nml
   n_inner = 30
/

&ocean_diag_nml
   enabled  = .true.
   filename = "island_at_rest"
   dt_out   = 86400.0   ! daily snapshots
/

&output_nml
   output_dir     = "./out_island_at_rest"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0
/
