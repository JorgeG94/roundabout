! Cold-core (cyclonic) twin of vortex_beta.nml (vortex_dT = -2): drifts NW.
!
! A single mesoscale eddy is started in geostrophic / thermal-wind balance
! (ic_config = "balanced_vortex"), then left to drift on beta.  The
! upper and lower parts of a baroclinic vortex propagate at different
! speeds, so the vortex develops a VERTICAL TILT; analyse it with
! validation_examples/ocean/balanced_vortex/analyze_vortex_tilt.py (centre vs depth, tilt angle + azimuth vs
! time, surface-vorticity extremum/integral vs time).
!
! Reading list (physics only):
!   McWilliams & Flierl (1979, Deep-Sea Res. 26) -- beta drift of isolated
!     vortices: cyclones NW, anticyclones SW in the northern hemisphere;
!   Chassignet & Cushman-Roisin (1991, J. Phys. Oceanogr. 21) -- baroclinic
!     vortices on a beta-plane;
!   Sutyrin & Flierl (1994, J. Phys. Oceanogr. 24) -- beta-induced tilt and
!     vertical alignment;
!   Carton (2001, in Eddy Dynamics, Academic Press) -- review.
!
! vortex_beta_cyclone.nml is the cold-core (cyclone) twin.
!
! Setup: 400 km x 400 km closed box at 5 km, H = 4000 m flat bottom, 40
! layers (100 m; the Hv = 700 m core spans ~10), f0 = 1e-4 1/s (~43 N), beta = 2e-11 1/(m s) about the box
! centre, linear EOS, N = 2.5e-3 1/s (dT/dz = 4e-3 K/m; a cold core needs > 0.858|dT|/Hv = 2.45e-3 or N^2 < 0).  Vortex: R = 50 km,
! Hv = 700 m, +2 K warm anomaly at the surface centre -> peak surface
! speed ~0.3 m/s (Ro ~ 0.07).  Deformation radius (first baroclinic mode)
! N H / (pi f) ~ 32 km, so R/Rd ~ 2.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 80
   ny     = 80
   dx     = 5000.0
   dy     = 5000.0
   nghost = 4
/

&time_nml
   t_end        = 3456000.0   ! 40 days
   dt_fixed     = 600.0    ! internal-wave CFL: N = 2.5e-3, c1 = N H/pi = 3.2 m/s, dx = 5 km;
                                ! dt = 1200 s blows up within ~40 steps, 600 s is stable
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 40
/

&vcoord_nml
   vcoord_type = "sigma"      ! flat bed: layers are z levels that follow the SSH
/

&tracer_nml
   initial_salinity = 35.0
/

&ocean_topo_nml
   topo_config    = "flat"
   max_depth      = 4000.0
   wind_config    = "constant"
   coriolis_beta  = 2.0e-11   ! 0 for the f-plane control (vortex_fplane.nml)
   coriolis_y_ref = 200000.0  ! f = f0 at the box centre (y = 200 km)
/

&ocean_thermo_nml
   enable_thermodynamics = .true.
/

&ocean_eos_nml
   eos = "linear"
/

&ocean_ic_nml
   ic_config       = "balanced_vortex"
   alpha_T         = 0.17
   rho_0           = 1035.0
   vortex_radius   = 50000.0
   vortex_hv       = 700.0
   vortex_dT       = -2.0
   vortex_T_surf   = 20.0
   vortex_dT_dz    = 4.0e-3
   vortex_balance  = "geostrophic"
/

&ocean_hvisc_nml
   nu_h = 100.0
/

&ocean_vmix_nml
   use_closure = .false.
   use_kpp     = .false.
/

&ocean_bt_nml
   split_scheme = "pred_corr"
   auto_n_inner = .true.
/

&ocean_diag_nml
   enabled  = .true.
   filename = "vortex_beta_cyclone"
   dt_out   = 86400.0         ! daily
   diags    = "vorticity_z:1d  SSH:1d  temperature:1d  u:off  v:off  KE:off"
/

&output_nml
   output_dir      = "./out_vortex_beta_cyclone"
   output_to_file  = .true.
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0
/
