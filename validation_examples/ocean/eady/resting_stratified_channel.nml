! Resting stratified channel — the OUTER-SPLIT rest-preservation benchmark.
!
! WHAT THIS IS. `eady.nml` with the front switched OFF (eady_dT_dy = 0) and
! the constant Laplacian viscosity switched off (nu_h = 0): a motionless,
! stably stratified, flat-bottomed periodic channel, seeded with the same
! ±0.5 mK white-noise temperature perturbation, and then left alone. No wind,
! no surface flux, no bottom drag, no vertical mixing closure, no topography.
!
! A motionless stratified fluid with no forcing has NO ENERGY SOURCE. Every
! joule of kinetic energy this configuration develops is numerical. That makes
! En a direct, unambiguous readout of one thing — the amount of spurious
! energy the OUTER time-split manufactures out of the internal-gravity-wave
! field — with the usual confounders removed by construction:
!
!   * flat bottom          => no spurious terrain-following pressure gradient
!   * dT_dy = 0            => no baroclinic instability, no thermal-wind jet
!   * nu_h = 0             => nothing damping the answer into the floor
!                             (Smagorinsky KH/AH and nu_4 = 5e8 remain, so
!                             the grid scale is still controlled)
!   * pert_amp = 1e-3 K    => a seed that is the ONLY thing distinguishing
!                             this state from exact rest. With
!                             eady_pert_amp = 0 the run is bit-zero
!                             (En = 0.000E+00 exactly) under both schemes.
!
! WHY IT IS IN THE SUITE. Measured on this configuration at day 25 (V100,
! nvfortran; the gfortran RNG realisation of the seed differs, the conclusion
! does not):
!
!     split_scheme = "ssp_rk2"     En = 2.992E-05 m²/s²  (7.7 mm/s rms)
!     split_scheme = "pred_corr"   En = 1.739E-09 m²/s²  (59 um/s rms)
!                                                        -- 17000x smaller
!
! Everything else was exonerated by direct substitution, each holding En to
! within 0.1% of the 2.99e-05 baseline: the Coriolis form (sadourny_hk,
! sadourny_energy), the ALE remap (vcoord = sigma, no remap at all), and the
! pressure-gradient form (fv_lite in place of the mont default). Removing the
! stratification instead (eady_dT_dz = 0) drops En 119x, to 2.5e-07 — the
! growth needs an internal-wave field to feed on. Turning lateral viscosity
! fully off RAISES it to 6.5e-05, i.e. viscosity damps the mode and is not
! its source. What remains, and what the substitution above identifies, is
! the outer split: SSP-RK2's two identical stages amplify a gravity wave as
! sqrt(1 + (omega dt)^4 / 4) per step, while the MOM6 predictor-corrector's
! forward-backward pairing is neutrally stable to omega dt = 2.
!
! So this file is the regression test for that class of defect. It is run
! under BOTH outer schemes by tests/regression/stability_manifest.py:
!   * as the BASE case it runs the default, split_scheme = "pred_corr", and
!     PASSES the magnitude gate (0.5e-6 m²/s², 1 mm/s) with margin; it is a
!     documented XFAIL only on the SETTLE gate, because pred_corr slows the
!     residual growth ~36x (83-day e-folding) rather than removing it;
!   * the `__ssp_rk2` twin the scheme axis builds XFAILs BOTH gates. That is
!     what the EXPERIMENTAL label on ssp_rk2 means, stated as a number, and
!     it is exactly why the bar is NOT widened to let it through.
! That four-decade separation is the point of the file.
!
! Expected outcome under pred_corr (the default):
!   * En <= ~2e-09 m²/s² at day 25, i.e. under 0.1 mm/s of spurious current.
!   * MaxCFL ~ 1e-4. No velocity clamping, no CFL truncation.
!   * Mass / Salt / Heat budget residuals at roundoff (~1e-14 relative).
!   * The temperature range must not spread: the resting-state T extrema
!     drift by < 1 mK. (Under ssp_rk2 they shrink ~0.5 K at each end in 25
!     days, which is the same defect seen in the tracer field.)
!
! Provenance: tmp_local_artifacts/eady_hunt/p3/Z_nu0 (the hunt that produced
! the substitution table above); the "Known issue" block of eady.nml, which
! this file now closes for the default scheme.  The default became
! pred_corr on 2026-09-14, largely on the strength of this measurement.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 50
   ny     = 50
   dx     = 5000.0
   dy     = 5000.0
   nghost = 3            ! periodic-x requires nghost >= 3 (PPM + biharmonic
                         ! stencil depth at the seam)
/

&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/

&time_nml
   t_end        = 2160000.0   ! 25 days — long enough for the ssp_rk2 mode to
                              ! clear 4 decades above the pred_corr answer
                              ! (the run length IS the gate: at 2 days both
                              ! schemes read ~1e-09 and the file proves
                              ! nothing)
   dt_fixed     = 600.0       ! 10 min outer
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 10
/

&vcoord_nml
   vcoord_type = "zstar"
/

&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 10.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config       = "flat"
   max_depth         = 1000.0
   wind_config       = "constant"
   coriolis_beta     = 0.0          ! f-plane
   coriolis_y_ref    = 0.0
/

&ocean_ic_nml
   ic_config         = "eady"
   alpha_T           = 0.17
   rho_0             = 1035.0
   eady_dT_dz        = 0.01         ! N² = 1.61e-5 s^-2 — the stratification
                                    ! the spurious mode feeds on
   eady_dT_dy        = 0.0          ! NO front: nothing to be unstable
   eady_T_ref        = 10.0
   eady_pert_amp     = 1.0e-3       ! ±0.5 mK seed; 0 makes the run bit-zero
   eady_pert_seed    = 12345
/

&ocean_pgf_nml
   maxvel        = 2.0
/

&ocean_hvisc_nml
   ! nu_h = 0 DELIBERATELY: the constant Laplacian floor suppresses the
   ! spurious mode's LEVEL without changing its rate (nu_h = 20 holds it at
   ! En 1.3e-7, nu_h = 100 at 1.6e-11), so leaving it in would let a
   ! regression hide behind viscosity. The Smagorinsky pair and the
   ! background biharmonic stay on to control the grid scale.
   nu_h            = 0.0
   nu_4            = 5.0e8
   lateral_closure = "smagorinsky"
   c_smag          = 0.15
   smag_ah         = .true.
   smag_bi_const   = 0.06
   nu_4_max        = 5.0e8
/

&ocean_vmix_nml
   use_closure  = .false.       ! Pure dyn-core test
   use_kpp      = .false.
/

&ocean_bt_nml
   n_inner           = 20            ! dt_inner = 30 s
/

&ocean_diag_nml
   enabled  = .true.
   filename = "resting_stratified_channel"
   dt_out   = 86400.0     ! daily
/

&output_nml
   output_dir      = "./out_resting_stratified_channel"
   output_to_file  = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0         ! daily progress
/
