! Eady baroclinic front + WENO5-Z windowed tracer advection.
!
! Identical dyn-core setup to eady.nml (reentrant channel, 50x50x10,
! zstar, Smagorinsky KH+AH dissipation stack, Eady thermal-wind IC with
! a REAL horizontal T gradient dT/dy) — the one change is the tracer
! transport path:
!
!   &ocean_vmix_nml
!      dt_tracer_advect_ratio = 2    ! turns ON the windowed tracer-advect drain
!      dt_therm_ratio         = 2    ! must be an integer multiple of the above
!      tracer_recon           = "weno5"  ! drain face reconstruction (WENO5-Z)
!
! This exercises src/tracer/structured/rdb_recon_weno.F90 (weno5 +
! plm swept-average face helpers + the rung-degradation ladder) via the
! ocean continuity-PPM windowed drain (drain_swept_flux_{x,y}_weno). The
! Eady IC gives T a genuine horizontal gradient from step 0, so WENO
! reconstructs a non-flat field and does real work — NOT a quiescent /
! uniform-tracer reconstruction. nghost=3 already satisfies weno5.
!
! Regression-suite case; see eady.nml for the full physics rationale,
! the analytical Eady scales and the 2026-09-13 re-baseline (dT_dy = -2e-5,
! nu_h = 20, 60 days). Measured with this file on a V100: the kx = 2 (125 km)
! mode grows at sigma = 1.93e-6 1/s (max|v| fit, days 30-60; theory 1.98e-6),
! max|v| ~1500x over the run, grid-scale content < 0.1%, MaxCFL <= 0.041 —
! indistinguishable from eady.nml, so the windowed WENO drain is not
! damping or exciting the mode.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 50
   ny     = 50
   dx     = 5000.0
   dy     = 5000.0
   nghost = 3            ! weno5 requires nghost >= 3 (already met by eady)
/

! Reentrant channel: periodic in x, walls north/south.
&ocean_bc_nml
   west = "periodic"
   east = "periodic"
/

&time_nml
   t_end        = 5184000.0   ! 60 days, as eady.nml (regression runner shortens this)
   dt_fixed     = 600.0       ! 10 min outer
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 10
/

&vcoord_nml
   vcoord_type = "zstar"
/

&tracer_nml
   initial_salinity    = 35.0
   initial_temperature = 10.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config       = "flat"
   max_depth   = 1000.0
   wind_config       = "constant"
   coriolis_beta     = 0.0          ! f-plane
   coriolis_y_ref    = 0.0
/

&ocean_ic_nml
   ic_config         = "eady"
   alpha_T     = 0.17
   rho_0       = 1035.0
   eady_dT_dz        = 0.01
   eady_dT_dy        = -2.0e-5      ! as eady.nml (re-baselined 2026-09-13)
   eady_T_ref        = 10.0
   eady_pert_amp     = 1.0e-3
   eady_pert_seed    = 12345
/

&ocean_pgf_nml
   maxvel        = 2.0
/

&ocean_hvisc_nml
   nu_h          = 20.0         ! as eady.nml (re-baselined 2026-09-13)
   nu_4          = 5.0e8
   lateral_closure = "smagorinsky"
   c_smag        = 0.15
   smag_ah       = .true.
   smag_bi_const = 0.06
   nu_4_max      = 5.0e8
/

&ocean_vmix_nml
   use_closure  = .false.
   use_kpp      = .false.
   ! --- Windowed tracer-advect drain with WENO5-Z face reconstruction ---
   dt_tracer_advect_ratio = 2       ! > 1 turns ON the windowed drain
   dt_therm_ratio         = 2       ! integer multiple of the advect ratio
   tracer_recon           = "weno5" ! WENO5-Z swept-average face
/

&ocean_bt_nml
   ! PINNED, and LOAD-BEARING: since 2026-09-14 "ssp_rk2" is NOT the
   ! default (pred_corr is), so without this line the file would not run.
   ! The pred_corr v1 envelope refuses dt_tracer_advect_ratio > 1 (the predictor's
   ! TR_MODE_NONE + window accounting is unexercised) -- a fail-loud
   ! `validate_config` error, not a silent downgrade. This file's subject IS
   ! the windowed tracer-advect drain, so the pin is what keeps the stability
   ! suite's outer-split axis (tests/regression/stability_manifest.py) from
   ! building an impossible pred_corr twin of it. Lifting the pin needs the
   ! windowed path wired through the predictor-corrector loop.
   split_scheme = "ssp_rk2"
   n_inner           = 20
/

&ocean_diag_nml
   enabled  = .true.
   filename = "eady_weno5"
   dt_out   = 21600.0
/

&output_nml
   output_dir      = "./out_eady_weno5"
   output_to_file  = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0
/
