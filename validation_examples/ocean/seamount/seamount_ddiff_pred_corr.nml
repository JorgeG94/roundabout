! Stratified seamount — double diffusion under the pred_corr split scheme.
!
! Sibling of seamount_ddiff.nml (see it for the full physics rationale):
! the IDENTICAL warm+salty-over-cool+fresh fingering column (R_rho ~= 1.30),
! but with `&ocean_bt_nml split_scheme="pred_corr"` PINNED rather than left
! ssp_rk2.  Double diffusion lives in the shared vmix_apply_in_stage, so it
! is applied in the pred_corr CORRECTOR (where the thermodynamic update runs);
! this case proves the closure fires clean under the predictor-corrector
! integrator, closing the "callable from both RK2 schemes" question
! end-to-end.
!
! Large, McWilliams & Doney (1994); Schmitt (1981).

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 96
   ny     = 96
   dx     = 4000.0
   dy     = 4000.0
   nghost = 3
/

&time_nml
   t_end        = 2.0
   time_unit    = "day"
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 20
/

&vcoord_nml
   vcoord_type = "zstar_sigma"
/

! Warm+salty over cool+fresh: fingering-favorable, R_rho ~= 1.30.
&tracer_nml
   initial_temperature = 12.5
   initial_salinity    = 35.0
   T_init_surface      = 20.0
   T_init_bottom       = 4.0
   S_init_surface      = 36.75
   S_init_bottom       = 34.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 4000.0
   edge_depth     = 200.0
   slope_scale    = 40000.0
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

&ocean_hvisc_nml
   nu_h = 5.0e2
   nu_4 = 0.0
/

&ocean_vmix_nml
   use_closure = .true.
   use_kpp     = .true.
/

! --- double diffusion (the coverage target) ------------------------------
&ocean_ddiff_nml
   enable = .true.
/

&ocean_bt_nml
   n_inner      = 60          ! dt_inner = 5 s; gravity-wave CFL = 0.49 at H=4000 m
   split_scheme = "pred_corr"   ! MOM6 predictor-corrector outer loop (pinned; also the default)
/

&ocean_diag_nml
   enabled = .false.
/

&output_nml
   output_dir     = "./out_seamount_ddiff_pred_corr"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 1.0
/
