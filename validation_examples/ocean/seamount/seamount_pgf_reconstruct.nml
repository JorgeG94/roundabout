! Stratified seamount — FV_MOM6 in-layer T/S reconstruction PGF coverage case.
!
! Purpose (regression coverage, NOT validation): exercise the in-layer
! PLM/PPM temperature/salinity reconstruction used by the finite-volume
! MOM6-style pressure-gradient density integral    -> rdb_ocean_pgf_reconstruct
!
! The FV_MOM6 PGF with `reconstruct_for_pressure=.true.` reconstructs a
! sub-layer T/S profile (PLM here, recon_scheme=1) and integrates the density
! through it (Boole quadrature) instead of using the layer-mean density.  The
! 20->4 C stratification over the seamount gives a real vertical density
! gradient for the reconstruction to act on.
!
! Small + short for the regression budget: 96x96 @ 4 km, 20 layers.
!
! Adcroft, Hallberg & Harrison (2008) Ocean Modelling 22:106 (FV PGF);
! Engwirda, Kelley & Marshall (2017) Ocean Modelling 116:1 (in-layer recon).

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 96
   ny     = 96
   dx     = 4000.0
   dy     = 4000.0
   nghost = 3
/

&time_nml
   t_end        = 2.0
   time_unit    = "day"
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 20
/

&vcoord_nml
   vcoord_type = "zstar_sigma"
/

&tracer_nml
   initial_temperature = 12.5
   initial_salinity    = 35.0
   T_init_surface      = 20.0
   T_init_bottom       = 4.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 4000.0
   edge_depth     = 200.0
   slope_scale    = 40000.0
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

! --- FV_MOM6 PGF with in-layer T/S reconstruction (the coverage target) --
&ocean_pgf_nml
   form                     = "fv_mom6"
   reconstruct_for_pressure = .true.   ! in-layer PLM/PPM T/S recon
   recon_scheme             = 1        ! 1 = PLM
   mass_weight              = .true.
/

&ocean_hvisc_nml
   nu_h = 5.0e2
   nu_4 = 0.0
/

&ocean_vmix_nml
   use_closure = .true.
   use_kpp     = .true.
/

&ocean_bt_nml
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
/

&ocean_diag_nml
   enabled = .false.
/

&output_nml
   output_dir     = "./out_seamount_pgf_reconstruct"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 1.0
/
