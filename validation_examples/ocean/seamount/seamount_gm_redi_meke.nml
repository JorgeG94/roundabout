! Stratified seamount — mesoscale lateral-closure coverage case.
!
! Purpose (regression coverage, NOT validation): light up the mesoscale
! eddy-parameterization stack in a single stratified, eddying seamount run:
!   * isopycnal (neutral) slope diagnostics  (Griffies 1998)      -> rdb_ocean_isopycnal_slopes
!   * Gent-McWilliams eddy-induced thickness transport (bolus)     -> rdb_ocean_gm
!   * Redi along-isopycnal (neutral) tracer diffusion              -> rdb_ocean_redi
!   * MEKE prognostic mesoscale-eddy kinetic energy (GM<->eddy)    -> rdb_ocean_meke
!
! Dependency chain enforced by &configure_ocean:
!   MEKE  requires  GM enable
!   GM    requires  &ocean_slopes_nml enable
! so all four modules are wired on together here.  APE from the 20->4 C
! stratification over the seamount feeds baroclinicity, which is what makes
! the slope/GM/MEKE terms non-trivial (they are ~no-ops in a resting state).
!
! Kept small + short for the regression budget: 96x96 @ 4 km, 20 layers,
! zstar_sigma remap, Laplacian viscosity for stability.  A handful of outer
! steps is enough for gcov (the closures fire every step).
!
! Gent & McWilliams (1990) JPO 20:150; Redi (1982) JPO 12:1154;
! Griffies (1998) JPO 28:831.

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 96
   ny     = 96
   dx     = 4000.0
   dy     = 4000.0
   nghost = 3
/

&time_nml
   t_end        = 2.0
   time_unit    = "day"
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 20
/

&vcoord_nml
   vcoord_type = "zstar_sigma"
/

&tracer_nml
   initial_temperature = 12.5
   initial_salinity    = 35.0
   T_init_surface      = 20.0
   T_init_bottom       = 4.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 4000.0
   edge_depth     = 200.0
   slope_scale    = 40000.0
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

&ocean_hvisc_nml
   nu_h = 5.0e2
   nu_4 = 0.0
/

&ocean_vmix_nml
   use_closure = .true.
   use_kpp     = .true.
/

! --- mesoscale lateral-closure stack (the coverage target) ---------------
&ocean_slopes_nml
   enable = .true.       ! isopycnal-slope diagnostics (GM/Redi consume these)
/

&ocean_gm_nml
   enable         = .true.
   khth           = 200.0    ! thickness diffusivity KhTh (m^2/s)
   khth_slope_max = 0.01     ! safe-streamfunction blend above this slope
/

&ocean_redi_nml
   enable     = .true.
   continuous = .true.
   khtr       = 200.0        ! neutral tracer diffusivity KhTr (m^2/s)
/

&ocean_meke_nml
   enable  = .true.          ! requires GM (sources from gm_src)
   gmcoeff = 0.15            ! PE->MEKE conversion efficiency
   khcoeff = 1.0             ! MEKE->Kh scaling
   damping = 1.0e-6          ! linear MEKE dissipation
/

&ocean_bt_nml
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
/

&ocean_diag_nml
   enabled = .false.
/

&output_nml
   output_dir     = "./out_seamount_gm_redi_meke"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 1.0
/
