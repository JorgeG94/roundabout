! Stratified seamount — FV_MOM6 in-layer PPM T/S reconstruction PGF coverage.
!
! Purpose (regression coverage, NOT validation): exercise the OTHER branch of
! the in-layer pressure-gradient density reconstruction that the batch-1
! seamount_pgf_reconstruct case (recon_scheme=1, PLM) left cold:
!                                                 -> rdb_ocean_pgf_reconstruct
!   * recon_scheme=2 selects the PPM edge-value reconstruction
!       (ppm_edges_column, the implicit-h4 fourth-order edge estimate with the
!       Colella-Woodward monotonic limiter) instead of the PLM slope path, and
!   * flips the Boole-quadrature density integral into its parabolic branch
!       (boole_dpa_intz_layer with parabolic=.true., adding the s6/t6 curvature
!       term) instead of the linear PLM profile.
! ppm_edges_column is the single largest uncovered block in the module, so
! this one case closes most of the reconstruct-path gap.
!
! The 20->4 C stratification over the seamount gives a real vertical density
! gradient for the parabolic sub-layer profile to act on.  Small + short for
! the regression budget: 96x96 @ 4 km, 20 layers.
!
! Adcroft, Hallberg & Harrison (2008) Ocean Modelling 22:106 (FV PGF);
! Colella & Woodward (1984) J. Comput. Phys. 54:174 (PPM);
! Engwirda, Kelley & Marshall (2017) Ocean Modelling 116:1 (in-layer recon).

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 96
   ny     = 96
   dx     = 4000.0
   dy     = 4000.0
   nghost = 3
/

&time_nml
   t_end        = 2.0
   time_unit    = "day"
   dt_fixed     = 300.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 1.0e-4
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 20
/

&vcoord_nml
   vcoord_type = "zstar_sigma"
/

&tracer_nml
   initial_temperature = 12.5
   initial_salinity    = 35.0
   T_init_surface      = 20.0
   T_init_bottom       = 4.0
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_topo_nml
   topo_config    = "seamount"
   max_depth      = 4000.0
   edge_depth     = 200.0
   slope_scale    = 40000.0
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

! --- FV_MOM6 PGF with in-layer PPM T/S reconstruction (the coverage target) -
&ocean_pgf_nml
   form                     = "fv_mom6"
   reconstruct_for_pressure = .true.   ! in-layer PLM/PPM T/S recon
   recon_scheme             = 2        ! 2 = PPM (vs 1 = PLM in batch-1)
   mass_weight              = .true.
/

&ocean_hvisc_nml
   nu_h = 5.0e2
   nu_4 = 0.0
/

&ocean_vmix_nml
   use_closure = .true.
   use_kpp     = .true.
/

&ocean_bt_nml
   auto_n_inner  = .true.
   cfl_bt_safety = 0.65
/

&ocean_diag_nml
   enabled = .false.
/

&output_nml
   output_dir     = "./out_seamount_pgf_ppm"
   output_to_file = .false.
/

&logging_nml
   log_level       = "info"
   status_interval = 1.0
/
