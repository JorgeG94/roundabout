! Stefan column (I1) -- one wet column of the CICE-port sea ice (scheme = "cice")
! over a 20 m ocean slab at its freezing point, constant -30 C air, 60 days.
!
! The matching test is tests/test_cice_stefan_column.F90 (ctest -R cice_stefan_column).
! It builds this same namelist in memory and compares the ice thickness with an
! independent fine-grid enthalpy-method solution of the Stefan (1891) freezing
! problem (Pringle et al. 2007 conductivity, Bitz and Lipscomb 1999 brine
! enthalpy, Monin-Obukhov turbulent fluxes), to 2 percent; the ocean + ice heat,
! salt and water budgets close (heat to the Bitz and Lipscomb 1999 solver
! tolerance).  Thickness at day 60 is about 1.39 m.
!
! The atmosphere is the uniform one of &ocean_ice_atm_nml (no bulk-forcing files):
!   * uni_tas = 243.15 K (-30 C), uni_rlds = 198.2 W/m2 (= sigma T^4 of the air,
!     so a thin ice surface relaxes to the air temperature), uni_huss = 80 percent
!     of saturation over ice at -30 C, 5 m/s wind, no shortwave, no snowfall.
!   * The turbulent fluxes see the air POTENTIAL temperature,
!     T (1e5/psl)^0.286 = 242.25 K (the CICE coupling convention), 0.9 K below
!     uni_tas.
! Ice: ncat = 5, nilyr = 4; the seed is a 0.3 m slab at -10 C (surface) over the
! freezing point, conc = 1.  A doubly periodic 8 x 8 box (uniform, so EVP and transport are inert) is one
! column replicated; dt = 900 s for 5 760 steps = 60 days.
!
! Run:  rdb validation_examples/ocean/sea_ice/cice_stefan_column.nml
!       rdb --validate-only validation_examples/ocean/sea_ice/cice_stefan_column.nml

&sim_nml sim_type = 'ocean' /
&time_nml t_end = 5184000.0, dt_fixed = 900.0 /
&nonhydrostatic_nml nz_layers = 3 /
&tracer_nml initial_temperature = -1.836, initial_salinity = 34.0, T_init_surface = -1.836, T_init_bottom = -1.836 /
&ocean_bt_nml auto_n_inner = .true. /
&ocean_hvisc_nml nu_h = 200.0 /
&ocean_diag_nml enabled = .false. /
&grid_nml nx = 8, ny = 8, nghost = 3, dx = 20000.0, dy = 20000.0 /
&physics_nml coriolis_f = 1.4e-4, wind_stress_x = 0.0, wind_stress_y = 0.0 /
&vcoord_nml vcoord_type = 'sigma' /
&ocean_topo_nml topo_config = 'flat', max_depth = 20.0 /
&ocean_thermo_nml enable_thermodynamics = .true. /
&ocean_forcing_nml enable_components = .true. /
&ocean_vmix_nml dt_therm_ratio = 1 /
&ocean_ice_nml enable = .true., scheme = 'cice', ncat = 5, nilyr = 4, hfreeze = 20.0, sw_down = 0.0, snowfall = 0.0,
   dynamics = .true., transport = .true., ledger = .true. /
&ocean_ice_thermo_nml update_ocn_f = .true., emissivity = 0.985 /
&ocean_ice_dyn_nml advection = 'upwind', ndte = 40 /
&ocean_ice_ic_nml conc_config = 'uniform', conc = 1.0, h_ice = 0.3, t_ice = -10.0, h_snow = 0.0 /
&ocean_ice_atm_nml uni_tas = 243.15, uni_rlds = 198.2, uni_huss = 1.87e-4, uni_uas = 5.0, uni_vas = 0.0, iceruf = 5.0e-4 /
&ocean_bc_nml west = 'periodic', east = 'periodic', south = 'periodic', north = 'periodic' /
&output_nml output_to_file = .false. /
