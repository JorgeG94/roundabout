! Double-gyre, GROWN to NK=10 via the linear density-range IC.
!
! Same wind, bathymetry, Coriolis, drag and viscosity as the NK=2
! MOM6-reference double_gyre_mom6.nml — but instead of a hand-listed
! two-element `layer_rho_init`, the stratification is generated by the
! linear density-range knob (MOM6 `COORD_CONFIG="linear"` analogue):
!
!   &ocean_ic_nml  rho_lightest = 1035.0, rho_range = 2.0
!
! => 10 linearly-spaced layer densities, surface (k=10) ~1035.1 kg/m^3
!    up to bed (k=1) ~1036.9, uniform 0.2 kg/m^3 steps.  To change the
!    layer count, edit nz_layers ONLY — the densities self-populate.
!
! gprime PGF is a 2-layer reduced-gravity form, so this NK>2 config uses
! the z-corrected FV PGF (form="fv_lite"), which reads the per-layer
! `rho_layer` the linear knob fills, on a distributed z* coordinate.
!
! Illustrative "it scales" demo, NOT a tuned validation target — use
! double_gyre_mom6.nml (NK=2) for the MOM6 reference comparison.
!
! Run:
!   cd validation_examples/ocean/double_gyre
!   # first load your NVHPC + NetCDF toolchain (module load / spack / conda;
!   # see environments/) -- one toolchain per shell, never stack two
!   CUDA_VISIBLE_DEVICES=<gpu> ../../../build/rdb double_gyre_linear_nk10.nml

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 44
   ny     = 40
   nghost = 2
/

&ocean_grid_nml
   ! MOM6 AXIS_UNITS="degrees" + LENLON/LENLAT: dx/dy are DERIVED as arc
   ! lengths on rad_earth (no cos(lat)) => dx=dy = rad_earth·22·pi/180/44
   ! ~ 55659 m (0.5 deg/cell), self-documenting instead of a hand-computed
   ! metre spacing.
   axis_units = "degrees"
   len_lon    = 22.0
   len_lat    = 20.0
   rad_earth  = 6.378e6
/

&time_nml
   t_end        = 10.0
   time_unit    = "day"
   dt_fixed     = 1200.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 9.4e-5
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 10
/

&tracer_nml
   initial_temperature = 15.0
   initial_salinity    = 35.0
/

&ocean_ic_nml
   ! Linear density-range generator (MOM6 COORD_CONFIG="linear").  Set
   ! ONLY this (not layer_rho_init) — the two are mutually exclusive.
   rho_lightest = 1035.0
   rho_range    = 2.0
/

&ocean_coriolis_nml
   form = "sadourny_energy"
/

&ocean_thermo_nml
   enable_thermodynamics = .false.
/

&ocean_topo_nml
   topo_config       = "spoon"
   max_depth   = 2000.0
   edge_depth  = 100.0
   slope_scale = 400000.0
   wind_config       = "2gyre"
   taux_magnitude    = 0.1
   coriolis_beta     = 1.76e-11
   coriolis_y_ref    = 1113200.0
/

&ocean_pgf_nml
   ! z-corrected FV PGF — reads the per-layer rho_layer the linear knob
   ! fills (gprime is 2-layer reduced gravity, not usable at NK>2).
   form    = "fv_lite"
   maxvel  = 6.0
/

&ocean_bdrag_nml
   form  = "linear"
   r     = 2.5e-5
   hbbl  = 10.0
   bg_vel = 0.1
   bbl_thick_min = 0.1
/

&ocean_hvisc_nml
   nu_h        = 10000.0
   nu_4        = 0.0
   smag_ah      = .true.
   smag_bi_const = 0.06
   nu_4_bg      = 0.0
   nu_4_max     = 1.0e12
   lateral_closure = "smagorinsky"
   c_smag      = 0.15
   kh_vel_scale = 3.0e-3
   ah_max      = 1.0e4
/

&ocean_vmix_nml
   kv_ml_invz2 = 0.01
   hmix_fixed  = 20.0
   harmonic_visc = .true.
   dt_therm_ratio = 2
/

&ocean_bt_nml
   auto_n_inner      = .true.
   cfl_bt_safety     = 0.65
   bebt               = 0.2
/

&vcoord_nml
   ! Distributed z*-lite — spreads the 10 layers across the column
   ! (the NK=2 reference pins a single interface at -1000 m instead).
   vcoord_type = "zstar"
/

&ocean_diag_nml
   enabled  = .false.
   filename = "double_gyre_linear_nk10"
   dt_out   = 1.0
/

&output_nml
   output_dir     = "./out_double_gyre_linear_nk10"
   output_to_file = .false.
/

&logging_nml
   status_interval = 1.0
/
