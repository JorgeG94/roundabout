! Double-gyre at the MOM6-examples GPU-scaling size: NK=100, 512x256.
!
! Mirrors $GSCRATCH/MOM6-examples/ocean_only/double_gyre/MOM_override
! (generated by gpu-scaling-scripts/run_ensemble.sh, JOBSIZE=128, m=16, n=8):
!   COORD_CONFIG=linear, DENSITY_RANGE=2.0   -> &ocean_ic_nml rho_range = 2.0
!   NK=100                                   -> nz_layers = 100
!   NIGLOBAL=32*m=512, NJGLOBAL=32*n=256     -> nx, ny (domain stays 22x20 deg)
!   DT=1200/m=75, DT_THERM=2400/m=150        -> dt_fixed, dt_therm_ratio = 2
!   DT_FORCING=150                           -> (forcing is steady; no knob)
!   TIMEUNIT=75, DAYMAX=150                  -> 150 steps = 11250 s (NOT 150 days)
! Everything else is the stock MOM_input (the NK=2 reference envelope),
! carried by double_gyre_linear_nk10.nml.  Run it for throughput:
! output off, status line every 50 steps (ENERGYSAVEDAYS=50 x TIMEUNIT).

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 512
   ny     = 256
   nghost = 2
/

&ocean_grid_nml
   ! MOM6 AXIS_UNITS="degrees" + LENLON/LENLAT: dx/dy are DERIVED as arc
   ! lengths on rad_earth (no cos(lat)) => dx=dy = rad_earth·22·pi/180/44
   ! ~ 55659 m (0.5 deg/cell), self-documenting instead of a hand-computed
   ! metre spacing.
   axis_units = "degrees"
   len_lon    = 22.0
   len_lat    = 20.0
   rad_earth  = 6.378e6
/

&time_nml
   t_end        = 11250.0
   time_unit    = "s"
   dt_fixed     = 75.0
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 9.4e-5
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 100
/

&tracer_nml
   initial_temperature = 15.0
   initial_salinity    = 35.0
/

&ocean_ic_nml
   ! Linear density-range generator (MOM6 COORD_CONFIG="linear").  Set
   ! ONLY this (not layer_rho_init) — the two are mutually exclusive.
   rho_lightest = 1035.0
   rho_range    = 2.0
/

&ocean_coriolis_nml
   form = "sadourny_energy"
/

&ocean_thermo_nml
   enable_thermodynamics = .false.
/

&ocean_topo_nml
   topo_config       = "spoon"
   max_depth   = 2000.0
   edge_depth  = 100.0
   slope_scale = 400000.0
   wind_config       = "2gyre"
   taux_magnitude    = 0.1
   coriolis_beta     = 1.76e-11
   coriolis_y_ref    = 1113200.0
/

&ocean_pgf_nml
   ! z-corrected FV PGF — reads the per-layer rho_layer the linear knob
   ! fills (gprime is 2-layer reduced gravity, not usable at NK>2).
   form    = "fv_lite"
   maxvel  = 6.0
/

&ocean_bdrag_nml
   form  = "linear"
   r     = 2.5e-5
   hbbl  = 10.0
   bg_vel = 0.1
   bbl_thick_min = 0.1
/

&ocean_hvisc_nml
   nu_h        = 10000.0
   nu_4        = 0.0
   smag_ah      = .true.
   smag_bi_const = 0.06
   nu_4_bg      = 0.0
   nu_4_max     = 1.0e12
   lateral_closure = "smagorinsky"
   c_smag      = 0.15
   kh_vel_scale = 3.0e-3
   ah_max      = 1.0e4
/

&ocean_vmix_nml
   kv_ml_invz2 = 0.01
   hmix_fixed  = 20.0
   harmonic_visc = .true.
   dt_therm_ratio = 2
/

&ocean_bt_nml
   auto_n_inner      = .true.
   cfl_bt_safety     = 0.65
   bebt               = 0.2
/

&vcoord_nml
   ! Distributed z*-lite — spreads the 10 layers across the column
   ! (the NK=2 reference pins a single interface at -1000 m instead).
   vcoord_type = "zstar"
/

&ocean_diag_nml
   enabled  = .false.
   filename = "double_gyre_nk100_512x256"
   dt_out   = 1.0
/

&output_nml
   output_dir     = "./out_double_gyre_nk100_512x256"
   output_to_file = .false.
/

&logging_nml
   status_interval = 3750.0
/
