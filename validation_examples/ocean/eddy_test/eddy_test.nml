! Flat-bottom double-gyre eddy validation — the canonical "do we get
! eddies" test, modelled after MOM6 ocean_only/double_gyre.
!
! Setup:
!   * 1500 × 1500 km flat-bottom basin, 4000 m deep
!   * 5 km resolution → 300 × 300 cells, eddy-resolving at mid-latitudes
!     (Rossby radius ~33 km at 40°N with linear T stratification →
!     ~6 grid cells across it)
!   * 15 layers, linearly stratified T(z): 20°C surface → 5°C bottom
!     (provides the available potential energy that powers baroclinic
!     instability — without this, no eddies regardless of wind)
!   * Uniform S = 35 PSU
!   * 2gyre wind: sinusoidal τ_x(y) peaks at 0.1 Pa mid-domain (drives
!     a subtropical anticyclone + subpolar cyclone, classic Sverdrup)
!   * β-plane Coriolis at 40°N (f₀ = 9.4e-5, β = 1.76e-11)
!   * 30 days — long enough for the western boundary current to
!     destabilise and start shedding eddies (typical onset: day 15-25)
!
! What to look for in the output:
!   * Surface KE (`KE[time, k=nz-1, :, :]`) — eddy field appears as
!     closed circular hot spots, typically detaching from the WBC
!     after day 15
!   * SSH — anticyclonic eddies show as positive SSH bumps, cyclonic
!     as negative dips
!   * Temperature at mid-depth (e.g. k=8) — shows the wavy thermocline
!     that destabilises into eddies
!   * Density (out_density=.true.) — slumping isopycnals release the
!     APE that drives the instability
!   * Vertical velocity w (out_w=.true.) — peaks at eddy detachment
!     sites; clean baroclinic-instability signature
!
! Movie: 4-hr cadence → 180 frames over 30 days → smooth ~15 s gif
! at 12 fps via `animate_eddy_test.py` (sibling script).
!
! Expected wallclock single V100: ~10-15 min for 30 days.
! 300 × 300 × 15 = 1.35 M cells, dt_outer = 300 s (5 min) limited by
! baroclinic CFL with c ~ 3 m/s → ~8640 outer steps × dt 300s

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = 300
   ny     = 300
   dx     = 5000.0
   dy     = 5000.0
   nghost = 2
/

&time_nml
   !t_end        = 4592000.0   ! 30 days
   t_end = 432000
   dt_fixed     = 300.0       ! 5 min outer (baroclinic CFL)
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = 9.4e-5     ! 40°N
   wind_stress_x = 0.0        ! Overridden by 2gyre pattern
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = 15
/

&vcoord_nml
   vcoord_type = "sigma"      ! Flat bottom → sigma == z*
/

&tracer_nml
   initial_temperature = 12.5      ! Ignored when stratification on
   T_init_surface      = 20.0      ! Linear T(z): 20°C surface
   T_init_bottom       = 5.0       !            → 5°C bottom
   initial_salinity    = 35.0
/

&ocean_topo_nml
   topo_config       = "flat"
   max_depth   = 4000.0
   wind_config       = "2gyre"
   taux_magnitude    = 0.1         ! Peak τ_x amplitude
   coriolis_beta     = 1.76e-11    ! 40°N planetary β
   coriolis_y_ref    = 750000.0    ! Mid-domain (y = 1500/2 km)
/

&ocean_hvisc_nml
   nu_h        = 1.0e3       ! Munk BL δ_M = (ν/β)^(1/3) ≈ 37 km
/

&ocean_bt_nml
                                   ! → ~7 grid cells, well resolved
   n_inner           = 30          ! dt_inner = 10 s; surface gravity
/
&ocean_diag_nml
   enabled  = .false.
   filename = "eddy_test"
   dt_out   = 14400.0   ! Every 4 hr — 180 frames over 30 days
                                   ! (smooth ~15 s movie at 12 fps)
   vgrid    = "layer"   ! Native nz=15 layers — k=14 surface,
                                   ! k=8 mid-thermocline, k=0 bed
/

! Ocean diag registers SSH (2D) + T, S, u, v, KE, h_layer (per-layer).
! Derived diags (density, vorticity_z, w) are in the catalog at
! src/core/ocean/diag/rdb_ocean_diag_derived.F90 but not yet plumbed
! through the namelist — for the eddy movie we compute vorticity_z
! post-hoc from u/v in `animate_eddy_test.py`.

&output_nml
   output_dir      = "./out_eddy_test"
   output_to_file  = .false.       ! Legacy coastal output off; ocean_diag is the source
   compress_output = .true.        ! 3-5× smaller NetCDF (~11 GB → ~3 GB at 30 days);
   compress_level  = 1             ! deflate level 1 is optimal for the smooth ocean fields
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0       ! Progress line every model day
/
