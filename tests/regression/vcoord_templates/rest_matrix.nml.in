! ===================================================================
! THE REST-STATE MATRIX TEMPLATE -- generated, do not edit a copy.
!
! This is the ONE canonical definition of the rest-state problem the
! vertical-coordinate stability matrix runs.  `tests/regression/
! vcoord_matrix.py` substitutes the double-brace fields and emits one
! namelist per (geometry x stratification x EOS x coordinate family)
! into a scratch directory at run time.  Nothing in the matrix is
! checked in as a namelist: dozens of near-identical files rot, and a
! reader cannot tell which cell of the matrix a given file is.
!
! WHAT THE PROBLEM IS.  A motionless, stably stratified ocean on an
! f-plane with:
!
!   * NO forcing            -- no wind, no surface flux, no tides
!   * NO lateral viscosity  -- nu_h = nu_4 = 0, no flow-aware closure
!                              (INVISCID leg; see TWO LEGS below)
!   * NO bottom drag        -- (INVISCID leg)
!   * NO vertical mixing    -- use_closure = use_kpp = .false.
!   * isopycnals FLAT IN GEOPOTENTIAL z, laid by
!     `&ocean_zinit_nml source="linear"` -- NOT by a layer-index
!     profile, which would tilt them with a terrain-following
!     coordinate and hand the run real available potential energy to
!     convert.  Over a slope that distinction is the whole experiment.
!
! Such a state is the GLOBAL MINIMUM of potential energy under rigid
! boundaries, so APE is identically zero and there is no energy source
! of any kind.  Every joule of kinetic energy the run develops was
! manufactured by the discretisation -- which here means, almost
! entirely, by the vertical coordinate's pressure-gradient truncation
! over the geometry.  That is what the matrix measures.
!
! TWO LEGS share this template and differ ONLY in the dissipation:
!
!   * INVISCID (nu_h = 0, no drag) -- the hard probe.  A viscosity
!     that removes a spurious mode removes the measurement with it
!     (nu_h = 10 m2/s costs the rx0 mode twelve decades), so this leg
!     keeps it out and reports what the discretisation does on its own.
!     Its sigma-family growth is DOCUMENTED EXPECTED behaviour: MOM6
!     shows the same mode (see tests/regression/README.md).
!   * VISCOUS -- MOM6's shipped seamount closure (KH = 1000 m2/s +
!     KH_VEL_SCALE = 0.003 m/s + LINEAR_DRAG) translated onto this
!     grid.  This is the PASS/FAIL gate: a cell inside its family's
!     documented rx0 envelope must rest.
!
! Both legs run the FIXED CONFIGURATION v0.1.0 recommends: the exact
! finite-volume PGF (`form="fv_mom6"` + `reconstruct_for_pressure`),
! the linear-exact remap boundary cells and non-uniform weights, the
! fail-loud remap precondition guard, and closed staircase faces on
! z_fixed.  The generator fills the double-brace fields per leg.
! ===================================================================

&sim_nml
   sim_type = "ocean"
/

&grid_nml
   nx     = {{NX}}
   ny     = {{NY}}
   dx     = {{DX}}
   dy     = {{DY}}
   nghost = {{NGHOST}}
/

&time_nml
   t_end        = 86400.0        ! overwritten per tier by stability.py
   dt_fixed     = {{DT}}
   cfl_interval = 1
/

&physics_nml
   coriolis_f    = {{CORIOLIS_F}}
   wind_stress_x = 0.0
   wind_stress_y = 0.0
/

&nonhydrostatic_nml
   nz_layers = {{NZ}}
/

&vcoord_nml
   vcoord_type = "{{VCOORD}}"
   zstar_h_min = 1.0e-4
   remap_method = "{{REMAP}}"
   ! the fixed configuration (v0.1.0): linear-exact boundary cells,
   ! non-uniform-grid weights, and the fail-loud precondition guard
   remap_boundary_extrap     = .true.
   remap_nonuniform_weights  = .true.
   remap_check_preconditions = .true.
{{VCOORD_EXTRA}}
/

&ocean_topo_nml
   topo_config    = "{{TOPO_CONFIG}}"
   max_depth      = {{MAX_DEPTH}}
   edge_depth     = {{EDGE_DEPTH}}
   slope_scale    = {{SLOPE_SCALE}}
   wind_config    = "constant"
   taux_magnitude = 0.0
   coriolis_beta  = 0.0
   coriolis_y_ref = 0.0
/

{{CAVITY}}

&ocean_pgf_nml
   ! the fixed configuration (v0.1.0): the exact finite-volume PGF
   form                     = "fv_mom6"
   reconstruct_for_pressure = {{RECON_P}}
   p_top_in_bc              = {{P_TOP_IN_BC}}
   maxvel      = 2.0
/

&ocean_eos_nml
   eos = "{{EOS}}"
/

&ocean_ic_nml
   ! ISOMIP+ linear-EOS coefficients (Asay-Davis et al. 2016 Table 4).
   ! Ignored when eos = "wright", which carries its own polynomial.
   alpha_T = 3.8356948e-2
   beta_S  = 8.0587609e-1
   T_ref   = -1.0
   S_ref   = 34.2
   rho_0   = 1027.51
/

&ocean_zinit_nml
   enable    = .true.
   source    = "linear"
   lin_t_ref = {{LIN_T_REF}}
   lin_dt_dz = {{LIN_DT_DZ}}
   lin_s_ref = {{LIN_S_REF}}
   lin_ds_dz = {{LIN_DS_DZ}}
/

&tracer_nml
   ! Overwritten by the zinit overlay on the interior AND the ghosts;
   ! kept consistent so a reader is not misled about the seeded state.
   initial_temperature = {{LIN_T_REF}}
   initial_salinity    = {{LIN_S_REF}}
/

&ocean_coriolis_nml
   form = "sadourny"
/

&ocean_hvisc_nml
   ! {{LEG}} leg -- see the header.  Laplacian only (MOM6's seamount
   ! turns BIHARMONIC off).  `stress_tensor` selects MOM6's own operator,
   ! (1/h) div(h Kh strain); it is refused under zfixed_closed_faces, so
   ! the z_fixed cells carry the scalar velocity Laplacian instead.
   nu_h          = {{NU_H}}
   nu_4          = 0.0
   stress_tensor = {{STRESS_TENSOR}}
/

&ocean_bdrag_nml
   ! {{LEG}} leg.  Viscous: MOM6 LINEAR_DRAG, tau/rho_0 = CDRAG *
   ! DRAG_BG_VEL * u_bbl = 1e-4 m/s * u_bbl, spread over HBBL = 10 m.
   form = "{{BDRAG_FORM}}"
   cd   = 0.0
   r    = {{BDRAG_R}}
   hbbl = {{BDRAG_HBBL}}
/

&ocean_vmix_nml
   use_closure = .false.
   use_kpp     = .false.
/

&ocean_bt_nml
{{BT_EXTRA}}
   auto_n_inner = .true.
/

&ocean_diag_nml
   enabled  = .true.
   filename = "{{NAME}}"
   dt_out   = 86400.0
   ! `h_layer` is the LAYER-THICKNESS derived diagnostic: its console
   ! [diag] min is how the matrix reads thickness positivity and the
   ! vanished-layer count without opening a NetCDF file.
   diags    = "h_layer"
/

&output_nml
   output_dir     = "."
   output_to_file = .false.
{{BATHY_FILE}}
/

&logging_nml
   log_level       = "info"
   status_interval = 86400.0
/
