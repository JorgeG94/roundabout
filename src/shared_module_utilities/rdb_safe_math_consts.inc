! rdb_safe_math_consts.inc -- constants of record for the rdb_safe_math_*.inc bodies.
!
! INCLUDE ONCE per module (it declares module parameters; a second #include is a
! redeclaration error).  The body files (_core, _pow, _trig, _atan, _hyp, _erfc) go in
! the `contains` section, _core first where a header says so; a consumer takes only the
! ones it needs.  (A Debug `-Wall` build warns "unused PRIVATE module variable" for the
! fitted tables of body files that are not included; unused functions do not warn once
! the consumer exports or calls what it includes.)
!
! #include this in the SPECIFICATION part of the consuming module (before
! `contains`), then the body files in its `contains`.  The consumer
! supplies:
!
!    use, intrinsic :: ieee_arithmetic, only: ieee_is_nan, ieee_is_finite
!    use, intrinsic :: iso_fortran_env, only: int64
!    use rdb_constants, only: wp
!
! and `implicit none` / `private`.  The tables below are real64 values: `wp` must be
! real64 (the reductions are Cody-Waite splits of real64 words), and the check
! below stops the build otherwise.
!
! Splits are written as decimal literals with 20 significant digits so every
! compiler reads the same double.  The fitted tables (SM_ATAN_C ... SM_ERFC_C_Q)
! are generated by tools/gen_safe_math_coeffs.py; do not edit them by hand.

   ! Compile-time guard: a division by zero in a constant expression is a hard error
   ! on every supported compiler.  wp /= real64 would silently mis-reduce.
   integer, parameter :: SM_WP_IS_REAL64 = 1/merge(1, 0, wp == selected_real_kind(15, 307))

   ! ---- IEEE special values as constants ----
   ! Decimal int64 bit patterns through a constant-expression `transfer` (no BOZ literal;
   ! `transfer` in a parameter is still untested on flang-new / LFortran).
   ! Not ieee_value(): on the device nvfortran materialises its class argument as a
   ! derived-type global, and two different classes (NaN and Inf) in one module collide
   ! ("forward reference and definition of global have different types", NVVM).
   real(wp), parameter :: SM_INF = transfer(9218868437227405312_int64, 1.0_wp)   ! bits 7FF0..0
   real(wp), parameter :: SM_NAN = transfer(9221120237041090560_int64, 1.0_wp)   ! bits 7FF8..0

   ! ---- exp / log : ln2 = LN2_HI + LN2_LO (+ LN2_LL) ----
   ! LN2_HI has 29 significant bits, so k*LN2_HI is exact for |k| < 2**24 without FMA
   ! (|k| <= 1075 here).
   real(wp), parameter :: SM_LN2_HI = 0.69314718060195446014_wp
   real(wp), parameter :: SM_LN2_LO = -4.2009150726810845979e-11_wp
   real(wp), parameter :: SM_INV_LN2 = 1.442695040888963387_wp
   real(wp), parameter :: SM_EXP_MAX = 709.78271289338399679_wp      ! log(huge): above this exp = +Inf
   real(wp), parameter :: SM_EXP_MIN = -745.1332191019412_wp         ! below this exp rounds to 0
   real(wp), parameter :: SM_SQRT_HALF = 0.70710678118654757274_wp
   real(wp), parameter :: SM_TWO54 = 18014398509481984.0_wp
   real(wp), parameter :: SM_SPLIT = 134217729.0_wp                   ! 2**27 + 1, Veltkamp split

   ! ---- sin / cos / tan : pi/2 = P1 + P2 + P3, P1 with 31 and P2 with 32 significant bits ----
   ! k*P1 and k*P2 are exact for |k| < 2**20, i.e. |x| < 1.6e6 (the 53-bit product holds
   ! 31 + 20 and 32 + 20 bits).
   real(wp), parameter :: SM_PIO2_1 = 1.5707963267341256142_wp
   real(wp), parameter :: SM_PIO2_2 = 6.0771005063039659766e-11_wp
   real(wp), parameter :: SM_PIO2_3 = 2.0222662487959506315e-21_wp
   real(wp), parameter :: SM_INV_PIO2 = 0.63661977236758138243_wp
   real(wp), parameter :: SM_TRIG_MAX = 1.6e6_wp

   ! ---- atan / atan2 ----
   real(wp), parameter :: SM_PIO2_HI = 1.570796326794896558_wp
   real(wp), parameter :: SM_PIO2_LO = 6.1232339957367660359e-17_wp
   real(wp), parameter :: SM_PI_HI = 3.141592653589793116_wp
   real(wp), parameter :: SM_PI_LO = 1.2246467991473532072e-16_wp
   real(wp), parameter :: SM_PIO4_HI = 0.785398163397448279_wp
   real(wp), parameter :: SM_PIO4_LO = 3.0616169978683830179e-17_wp
   real(wp), parameter :: SM_SQRT3 = 1.7320508075688771932_wp
   real(wp), parameter :: SM_PIO6_HI = 0.52359877559829892668_wp
   real(wp), parameter :: SM_PIO6_LO = -5.3604088322554549242e-17_wp
   real(wp), parameter :: SM_TAN_PIO12 = 0.2679491924311226958_wp     ! 2 - sqrt(3)

   ! ---- cosh ----
   real(wp), parameter :: SM_HALF_E = 1.3591409142295225454_wp

   ! ---- erfc ----
   real(wp), parameter :: SM_INV_SQRTPI = 0.56418958354775627928_wp

   ! ---- Taylor coefficients ----
   ! EXP_C(k) = 1/k!: 14 terms, truncation r**14/14! < 3e-19 at |r| = ln(2)/2.
   real(wp), parameter :: SM_EXP_C(0:13) = [1.0_wp, 1.0_wp, 1.0_wp/2.0_wp, 1.0_wp/6.0_wp, 1.0_wp/24.0_wp, &
      1.0_wp/120.0_wp, 1.0_wp/720.0_wp, 1.0_wp/5040.0_wp, 1.0_wp/40320.0_wp, 1.0_wp/362880.0_wp, &
      1.0_wp/3628800.0_wp, 1.0_wp/39916800.0_wp, 1.0_wp/479001600.0_wp, 1.0_wp/6227020800.0_wp]
   ! LOG_C(i) = 1/(2i+1): log m = 2 f (1 + f**2/3 + f**4/5 + ...), f = (m-1)/(m+1), |f| <= 0.172.
   real(wp), parameter :: SM_LOG_C(0:9) = [1.0_wp, 1.0_wp/3.0_wp, 1.0_wp/5.0_wp, 1.0_wp/7.0_wp, 1.0_wp/9.0_wp, &
      1.0_wp/11.0_wp, 1.0_wp/13.0_wp, 1.0_wp/15.0_wp, 1.0_wp/17.0_wp, 1.0_wp/19.0_wp]
   real(wp), parameter :: SM_SIN_C(0:8) = [1.0_wp, -1.0_wp/6.0_wp, 1.0_wp/120.0_wp, -1.0_wp/5040.0_wp, &
      1.0_wp/362880.0_wp, -1.0_wp/39916800.0_wp, 1.0_wp/6227020800.0_wp, -1.0_wp/1307674368000.0_wp, &
      1.0_wp/355687428096000.0_wp]
   real(wp), parameter :: SM_COS_C(0:8) = [1.0_wp, -1.0_wp/2.0_wp, 1.0_wp/24.0_wp, -1.0_wp/720.0_wp, &
      1.0_wp/40320.0_wp, -1.0_wp/3628800.0_wp, 1.0_wp/479001600.0_wp, -1.0_wp/87178291200.0_wp, &
      1.0_wp/20922789888000.0_wp]

   ! ---- fitted tables (generated) ----
   real(wp), parameter :: SM_ATAN_C(0:11) = [ &
      1.0_wp, -0.3333333333333333148_wp, 0.1999999999999998446_wp, &
      -0.1428571428571007162_wp, 0.1111111111054328693_wp, -0.09090909045700855395_wp, &
      0.07692305406260263601_wp, -0.06666590357759735741_wp, 0.05880646170199485545_wp, &
      -0.05237747786578652448_wp, 0.04518284953605152671_wp, -0.0295457862073798469_wp ]
   real(wp), parameter :: SM_ERF_C(0:11) = [ &
      1.128379167095512559_wp, -0.376126389031837538_wp, 0.1128379167095512614_wp, &
      -0.02686617064513124181_wp, 0.005223977625441806293_wp, -0.0008548327023363942604_wp, &
      0.0001205533296923066544_wp, -0.00001492564916290355896_wp, 1.64620383639705829e-6_wp, &
      -1.636264690374603956e-7_wp, 1.472152117638980096e-8_wp, -1.095865453884735107e-9_wp ]
   real(wp), parameter :: SM_CBRT_C(0:4) = [ &
