# Tier 0 — compiler portability, serial, NetCDF OFF.
#
# DISABLED by extension: GitHub Actions reads only `.yml`/`.yaml` here, so
# while this file is `.yml.disabled` it cannot run and costs no minutes.
# Enable with:
#
#     git mv .github/workflows/portability.yml.disabled \
#            .github/workflows/portability.yml
#
# WHY NetCDF OFF: netcdf-fortran writes compiler-specific `.mod` files, so a
# prebuilt one (conda-forge's is built with gfortran 14) cannot be consumed by
# gfortran 15+, ifx, nvfortran or flang. Building it per compiler is a separate,
# slower job. This tier deliberately drops that dependency and still builds the
# whole solver and 174 of the 187 tests -- `RDB_ENABLE_NETCDF` exists for
# exactly this.
#
# gfortran 10-14 are NOT in the matrix: the ocean kernels use F2018
# `do concurrent` locality specifiers, which GCC implements only from 15, and
# `cmake/toolchain_guards.cmake` fails loud below that.
#
# EXPECTED COUNTS: 174/174 on gfortran 15 (verified locally). Other compilers
# are unverified -- `fail-fast: false` so one compiler's failure does not hide
# another's result, and `continue-on-error` marks the exploratory ones so a red
# does not block a PR until its baseline is known. Promote a compiler out of
# `exploratory` once it has a known-good count.

name: Portability (serial, no NetCDF)

on:
  pull_request:
  workflow_dispatch:

concurrency:
  group: portability-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-and-test:
    name: ${{ matrix.toolchain.compiler }} ${{ matrix.toolchain.version }}
    runs-on: ubuntu-latest
    continue-on-error: ${{ matrix.exploratory }}
    strategy:
      fail-fast: false
      matrix:
        include:
          # Known-good baseline: 174/174.
          - toolchain: {compiler: gcc, version: 15}
            exploratory: false
          # Unverified. Each needs one green run before losing the flag.
          - toolchain: {compiler: intel, version: '2025.0'}
            exploratory: true
          - toolchain: {compiler: nvidia-hpc, version: '25.1'}
            exploratory: true
          - toolchain: {compiler: lfortran, version: '0.51.0'}
            exploratory: true

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Fortran compiler
        uses: fortran-lang/setup-fortran@v1.9.0
        id: setup-fortran
        with:
          compiler: ${{ matrix.toolchain.compiler }}
          version: ${{ matrix.toolchain.version }}

      - name: Report toolchain
        run: |
          echo "FC=${{ env.FC }}"
          ${{ env.FC }} --version || true

      - name: Configure
        run: >-
          cmake -B build -S .
          -DCMAKE_BUILD_TYPE=Release
          -DCMAKE_Fortran_COMPILER=${{ env.FC }}
          -DRDB_ENABLE_NETCDF=OFF
          -DRDB_ENABLE_MPI=OFF
          -DRDB_ENABLE_GPU=OFF
          -DRDB_ENABLE_TESTING=ON

      - name: Build
        run: cmake --build build --parallel

      # No `-j`: several tests share process-global state, and the suite is
      # fast enough serially that parallelism buys nothing but flakiness.
      - name: Test
        working-directory: build
        run: ctest -R rdb --output-on-failure
